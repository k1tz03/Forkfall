+  # ════════════════════════════════════════════════ pr.h10.rouvier · Le souffle
+  - id: pr.h10.ro.table
+    roles: [president]
+    arc: corps
+    tags: [tribunes, famille]
+    speaker: rouvier
+    lieu: cabinet
+    tone: leger
+    once: true
+    text: "Chez Nadia Rouvier, Gégé torse nu sur la table de la cuisine, le sifflet de la kiné à côté du sel : « Il respire avec la moitié de ce qu'il avait en 1990. Il veut aller au match samedi, {toi}. »"
+    left:
+      label: "Je le conduis"
+      effects: {direction: "-", tribunes: "+", relation: {gege: 1, rouvier: 1}, react: pr.h10.re.rouvier_couverture}
+      answer: "Elle range le sifflet dans sa poche. « Alors une couverture, et pas l'escalier. Vous le portez, s'il le faut. »"
+    right:
+      label: "Il écoutera à la radio"
+      effects: {tribunes: "-", direction: "+", relation: {gege: -1}, next: {step: radio, in: [1, 3]}}
+      answer: "Gégé se rhabille sans un mot, bouton par bouton, en commençant par le bas. Il oublie celui du col."
+
+  - id: pr.h10.ro.loge
+    roles: [president]
+    arc: corps
+    tags: [tribunes, moment]
+    speaker: gege
+    lieu: stade
+    tone: leger
+    once: true
+    text: "Samedi, Gégé dans ta loge, une couverture sur les genoux, entre deux invités de Rive Capital qui ne savent pas qui il est. Au premier but, il se lève. Seul."
+    left:
+      label: "Je me lève avec lui"
+      effects: {tribunes: "+", direction: "-", relation: {gege: 1}, set: [h10_gege_loge], outcome: loge}
+      answer: "Vous restez debout jusqu'à l'engagement. Les invités se lèvent à leur tour, par politesse, au moment où vous vous rasseyez."
+    right:
+      label: "Je reste à ma place"
+      effects: {tribunes: "-", direction: "+", set: [h10_gege_loge], outcome: loge}
+      answer: "Il se rassoit seul, la couverture tombée. Un invité la ramasse et la lui rend, en anglais."
+
+  - id: pr.h10.ro.radio
+    roles: [president]
+    arc: corps
+    tags: [tribunes, presse]
+    speaker: gege
+    lieu: stade
+    tone: leger
+    once: true
+    text: "Au-dessus du local, Gégé écoute le match au poste. Il appelle ta loge à la mi-temps : « La voix de la radio n'est pas celle du stade. Laquelle est la vraie, des deux ? »"
+    left:
+      label: "Aucune des deux"
+      effects: {direction: "-", tribunes: "+", set: [h10_gege_radio], outcome: radio}
+      answer: "« C'est ce que je pensais. » Il raccroche. Tu l'imagines baisser le son et regarder le mur."
+    right:
+      label: "Celle du stade"
+      effects: {tribunes: "-", direction: "+", relation: {gege: -1}, set: [h10_gege_radio], outcome: radio}
+      answer: "« Alors je vais éteindre. » Il éteint. Le local, en dessous, entend le silence descendre, et baisse la voix."
+
+  - id: pr.h10.ro.poche
+    roles: [president]
+    arc: corps
+    tags: [famille, retorse]
+    speaker: rouvier
+    lieu: cabinet
+    tone: leger
+    once: true
+    text: "Nadia Rouvier, le sac à l'épaule, regarde ta veste : « Elle tombe mal, à gauche, {toi}. J'ai eu un joueur comme ça, en 1997 : un téléphone pour sa femme, un pour l'autre. Il s'est cassé le genou. »"
+    left:
+      label: "C'est celui du club"
+      effects: {relation: {rouvier: 1}, set: [h10_rouvier_poche]}
+      answer: "« Alors le club t'appelle à trois heures du matin. » Elle te tapote la poche, deux fois, comme un ballon qu'on vérifie."
+    right:
+      label: "Ce n'est rien"
+      effects: {relation: {rouvier: -1}, set: [h10_rouvier_poche]}
+      answer: "« Rien, ça ne pèse rien. » Elle part sans fermer la porte, ce qu'elle fait quand elle veut qu'on la rappelle."
+
+  # ═════════════════════════════════════════ pr.h10.photo · La photo de 1974
+  - id: pr.h10.ph.lettre
+    roles: [president]
+    arc: direction
+    tags: [direction, objet]
+    speaker: josiane
+    lieu: secretariat
+    tone: leger
+    once: true
+    text: "Une lettre de Madame Josiane, d'une écriture tremblée : « J'ai la photo de 1974, celle de l'escalier. Je la garde depuis qu'on l'a décrochée. Venez la chercher avant mes cent ans, {toi}. »"
+    left:
+      label: "J'irai cette semaine"
+      effects: {tribunes: "-", direction: "+"}
+      answer: "Mireille sourit pour la première fois depuis septembre. « Elle mettra son collier. Elle le met pour les enterrements, et pour vous. »"
+    right:
+      label: "Qu'on me l'apporte"
+      effects: {direction: "-", next: {step: visite, in: [3, 5]}}
+      answer: "« Elle n'envoie rien par la poste depuis 1991. » Mireille repart avec la lettre. Sa tante viendra elle-même, en fauteuil."
+
+  - id: pr.h10.ph.visite_cadre
+    roles: [president]
+    arc: direction
+    tags: [direction, objet]
+    speaker: josiane
+    lieu: bureau
+    tone: leger
+    once: true
+    text: "Madame Josiane s'est fait monter au club-house en fauteuil, la photo de 1974 sur les genoux. Elle regarde ta photo de 2016, accrochée au clou de l'escalier : « Il n'y a qu'un clou. »"
+    left:
+      label: "Je décroche la mienne"
+      effects: {vestiaire: "-", tribunes: "+", direction: "+", set: [h10_photo_raccrochee], outcome: raccrochee, next: {step: gege, in: [2, 4]}, react: pr.h10.re.josiane_cadre}
+      answer: "Tu décroches la tienne, raccroches la sienne. Elle fait redresser le cadre trois fois, puis te rend ta photo, retournée."
+    right:
+      label: "Gardez la vôtre"
+      effects: {direction: "-", set: [h10_photo_tiroir], outcome: tiroir}
+      answer: "« C'est ce que je fais depuis 1991. » Elle demande à redescendre. Ta photo reste au clou, un peu de travers."
+
+  - id: pr.h10.ph.visite
+    roles: [president]
+    arc: direction
+    tags: [direction, objet]
+    speaker: josiane
+    lieu: bureau
+    tone: leger
+    once: true
+    text: "Madame Josiane s'est fait monter au club-house en fauteuil. Sur ses genoux, la photo de 1974, dans un numéro de L'Écho de 1991. Elle regarde le clou de l'escalier, pas toi."
+    left:
+      label: "Je la raccroche"
+      effects: {vestiaire: "-", tribunes: "+", direction: "+", set: [h10_photo_raccrochee], outcome: raccrochee, next: {step: gege, in: [2, 4]}, react: pr.h10.re.josiane_cadre}
+      answer: "Elle te fait redresser le cadre trois fois. « Voilà. » Elle demande à redescendre avant le café."
+    right:
+      label: "Gardez-la chez vous"
+      effects: {direction: "-", set: [h10_photo_tiroir], outcome: tiroir}
+      answer: "Elle la remballe dans le même journal, sans un mot. Mireille, elle, en a un, qu'elle garde pour l'escalier."
+
+  - id: pr.h10.ph.gege
+    roles: [president]
+    arc: direction
+    tags: [tribunes, objet]
+    speaker: gege
+    lieu: bureau
+    tone: strategique
+    once: true
+    text: "Gégé a monté l'escalier du club-house, marche par marche. Devant la photo de 1974 : « Ils sont tous dessus, ceux qui ont vendu et ceux qui ne savaient pas. On ne voit pas la différence. »"
+    left:
+      label: "On ne la voit jamais"
+      effects: {direction: "-", tribunes: "+", relation: {gege: 1}}
+      answer: "« Si. Au bout de soixante ans. » Il reste vingt minutes sur le palier. Mireille dit qu'il a parlé tout ce temps."
+    right:
+      label: "Je vous laisse avec eux"
+      effects: {relation: {gege: 1}}
+      answer: "Tu redescends. Il parle à la photo, à voix basse ; au secrétariat, Mireille monte le son de sa radio."
+
+  # ═══════════════════════════════════════ pr.h10.brac · Le car de huit heures
+  - id: pr.h10.br.message_vendu
+    roles: [president]
+    arc: mercato
+    tags: [mercato, formation]
+    speaker: brac
+    statut_ok: [vendu]
+    lieu: domicile
+    tone: leger
+    once: true
+    text: "Un message de la capitale : Elias Brac en survêtement neuf, devant un dortoir de quarante lits. « Ils disent “le petit d'Aubérive”. On est trois petits d'Aubérive, ici. »"
+    left:
+      label: "Reviens un dimanche"
+      effects: {direction: "-", tribunes: "+", relation: {brac: 1}}
+      answer: "Il répond par une photo prise de la vitre arrière du car de huit heures : le stade de la Rive, tout petit."
+    right:
+      label: "Tiens bon, là-bas"
+      effects: {tribunes: "-", direction: "+"}
+      answer: "« D'accord. » Le message suivant arrive six semaines plus tard : une photo de ses crampons neufs, rien d'autre."
+
+  - id: pr.h10.br.message_garde
+    roles: [president]
+    arc: mercato
+    tags: [mercato, formation]
+    speaker: brac
+    lieu: stade
+    tone: leger
+    once: true
+    text: "Elias Brac t'attend devant le club-house, son téléphone à la main : « La capitale a rappelé. Deux fois. Ils parlent à ma mère, pas à moi. Je leur réponds quoi, {toi} ? »"
+    left:
+      label: "Réponds-leur toi-même"
+      effects: {direction: "-", vestiaire: "+", set: [h10_brac_rappel], outcome: rappel}
+      answer: "Il compose le numéro devant toi, dit une phrase, raccroche. Tu n'as pas entendu laquelle ; il ne la répète pas."
+    right:
+      label: "Je leur réponds"
+      effects: {vestiaire: "-", direction: "+", outcome: rappel}
+      answer: "Tu appelles. On te répond que ce n'était qu'une prise de contact, et qu'on rappellera en juin. Sa mère."
+
+  - id: pr.h10.br.dimanche_vendu
+    roles: [president]
+    arc: mercato
+    tags: [mercato, tribunes]
+    speaker: brac
+    statut_ok: [vendu]
+    lieu: stade
+    tone: leger
+    once: true
+    text: "Un dimanche, Elias Brac en tribune Nord, capuche relevée, parmi les socios. Sous son blouson, le maillot de la capitale. Il te fait signe : il voudrait descendre au vestiaire."
+    left:
+      label: "Fais-le descendre"
+      effects: {direction: "-", tribunes: "+", vestiaire: "+", set: [h10_brac_revenu], outcome: revenu}
+      answer: "Il descend. Le vestiaire se tait, puis quelqu'un lui lance un ballon. Il jongle en blouson, vingt fois, sans le laisser tomber."
+    right:
+      label: "Pas aujourd'hui"
+      effects: {vestiaire: "-", direction: "+", outcome: loin}
+      answer: "Il remonte sa capuche. À la mi-temps, sa place est vide ; un socio s'y assoit sans savoir."
+
+  - id: pr.h10.br.dimanche_garde
+    roles: [president]
+    arc: mercato
+    tags: [mercato, tribunes]
+    speaker: brac
+    lieu: stade
+    tone: leger
+    once: true
+    text: "Contre {rival}, Elias Brac marque du gauche, court vers la Nord et brandit son téléphone, écran noir. Le soir, il t'attend au parking : « Je les ai bloqués. C'est bien, ou c'est bête ? »"
+    left:
+      label: "C'est bien"
+      effects: {direction: "-", vestiaire: "+", force: 1, relation: {brac: 1}}
+      answer: "Il sourit comme on sourit à dix-sept ans, avec tout le visage. Puis il rentre à pied, par la rue du Stade."
+    right:
+      label: "C'est bête"
+      effects: {vestiaire: "-", direction: "+", relation: {brac: -1}}
+      answer: "« C'est ce que dit ma mère. » Il débloque un numéro, un seul, devant toi. Tu ne vois pas lequel."
+
+  - id: pr.h10.br.article_loin
+    roles: [president]
+    arc: presse
+    tags: [presse, mercato]
+    speaker: lea
+    lieu: rue
+    tone: leger
+    once: true
+    text: "Léa, au kiosque du quai : « J'écris dimanche sur le petit Brac. Le titre, c'est “Parti par le car de huit heures”. Il me manque une phrase de vous, et je préférerais qu'elle soit vraie. »"
+    left:
+      label: "« Il reviendra. »"
+      effects: {direction: "-", tribunes: "+"}
+      answer: "Elle l'écrit sans la souligner. « On a dit ça de tous ceux du car. Certains sont revenus. Pour les enterrements. »"
+    right:
+      label: "« On l'a vendu. »"
+      effects: {direction: "-", tribunes: "+"}
+      answer: "Elle relève la tête, surprise. Dimanche, ta phrase est en gras, seule sur une ligne, sous une photo du car."
+
+  - id: pr.h10.br.article
+    roles: [president]
+    arc: presse
+    tags: [presse, formation]
+    speaker: lea
+    lieu: rue
+    tone: leger
+    once: true
+    text: "Léa, au kiosque du quai, un carnet ouvert : « J'écris dimanche sur le petit Brac. Le titre, c'est “Né à côté du stade”. Il me manque une phrase de vous. »"
+    left:
+      label: "« Il est d'ici. »"
+      effects: {vestiaire: "-", tribunes: "+"}
+      answer: "Elle l'écrit, la barre, la réécrit. « Ici, aujourd'hui, ça veut dire quoi ? » Elle ne te laisse pas répondre."
+    right:
+      label: "« Il est à lui. »"
+      effects: {tribunes: "-", vestiaire: "+"}
+      answer: "Elle souligne deux fois. Dimanche, ta phrase est en gras, sous une photo de Brac à neuf ans, en pyjama du Racing."
+
+  # ═════════════════════════════════════════════════════ pr.h10.mbako · La loi
+  - id: pr.h10.mb.vote_joueur
+    roles: [president]
+    arc: instances
+    tags: [direction, telephone]
+    speaker: mbako
+    lieu: bureau
+    tone: strategique
+    once: true
+    text: "La ligne du bureau, vingt-trois heures. Mbako : « Elle passe ce soir, à quatre voix. Tu jouais au foot en 1990, toi aussi ; je voulais que tu l'apprennes de moi, pas de L'Écho. »"
+    left:
+      label: "Je l'apprends de vous"
+      effects: {tribunes: "-", direction: "+", relation: {mbako: 1}}
+      answer: "« Merci. » Il ne raccroche pas tout de suite. Derrière lui, des gens applaudissent dans une salle trop grande."
+    right:
+      label: "Je préférais L'Écho"
+      effects: {direction: "-", tribunes: "+", relation: {mbako: -1}, react: pr.h10.re.lea_quatre_voix}
+      answer: "« Léa l'écrira mieux que moi. » Il raccroche. Dimanche, L'Écho titre sur quatre voix ; Léa a eu les noms."
+
+  - id: pr.h10.mb.vote
+    roles: [president]
+    arc: instances
+    tags: [direction, telephone]
+    speaker: mbako
+    lieu: bureau
+    tone: strategique
+    once: true
+    text: "La ligne du bureau, vingt-trois heures. Lian Mbako : « Elle passe ce soir, à quatre voix. Applicable à la fin de la saison prochaine. Je voulais que tu l'apprennes de moi, pas de L'Écho. »"
+    left:
+      label: "Je l'apprends de vous"
+      effects: {tribunes: "-", direction: "+", relation: {mbako: 1}}
+      answer: "« Merci. » Il ne raccroche pas tout de suite. Derrière lui, des gens applaudissent dans une salle trop grande."
+    right:
+      label: "Je préférais L'Écho"
+      effects: {direction: "-", tribunes: "+", relation: {mbako: -1}, react: pr.h10.re.lea_quatre_voix}
+      answer: "« Léa l'écrira mieux que moi. » Il raccroche. Dimanche, L'Écho titre sur quatre voix ; Léa a eu les noms."
+
+  - id: pr.h10.mb.commission
+    roles: [president]
+    arc: instances
+    tags: [direction, presse]
+    speaker: mbako
+    lieu: ailleurs
+    tone: strategique
+    once: true
+    text: "La Fédération, à la capitale, salle de la Commission des franchises. Mbako en bout de table : « Huit minutes par club, {toi}. Les autres en ont eu huit. Tu plaides, ou tu m'envoies ton capo ? »"
+    left:
+      label: "Je plaide"
+      effects: {vestiaire: "-", direction: "+", tribunes: "+", set: [h10_plaidoirie], outcome: plaidoirie}
+      answer: "Huit minutes. Tu parles de l'escalier nord, des marches, du maçon. À la septième, un commissaire regarde sa montre."
+    right:
+      label: "J'envoie Nino"
+      effects: {direction: "-", tribunes: "+", relation: {nino: 1}, set: [h10_nino_federation], outcome: nino, react: pr.h10.re.nino_cravate}
+      answer: "Nino plaide en écharpe. Il revient le soir avec une cravate neuve, qu'il dit avoir achetée à la gare."
+
+  - id: pr.h10.mb.couloir
+    roles: [president]
+    arc: instances
+    tags: [direction, retorse]
+    speaker: mbako
+    lieu: ailleurs
+    tone: strategique
+    once: true
+    text: "Couloir de la Fédération. Mbako t'arrête devant la machine à café : « En 1990, je voulais jouer tout de suite. J'ai joué tout de suite. Maintenant, je fais attendre les autres. Pour toujours. »"
+    left:
+      label: "Vous pouvez la défaire"
+      effects: {direction: "-", relation: {mbako: 1}}
+      answer: "« Une loi, ça se défait en dix ans. Une marche, en une nuit. » Il te paie le café et oublie de prendre le sien."
+    right:
+      label: "Vous avez choisi"
+      effects: {tribunes: "-", direction: "+", relation: {mbako: -1}}
+      answer: "« J'ai choisi huit clubs contre quatre-vingts. » Il boit son café d'un trait, comme un médicament."
+
+  # ═════════════════════════════════════ pr.h10.lea · La lettre du dimanche
+  - id: pr.h10.le.kiosque
+    roles: [president]
+    arc: presse
+    tags: [presse, tribunes]
+    speaker: lea
+    lieu: rue
+    tone: leger
+    once: true
+    text: "Kiosque du quai, dimanche. Léa, soixante-douze ans, attend son Écho : « La loi est votée, il reste dix-huit mois. J'écris la lettre de lecteur. Je la signe de mon nom, ou de celui du virage ? »"
+    left:
+      label: "De votre nom"
+      effects: {tribunes: "-", direction: "+", set: [h10_lettre_signee], outcome: signee}
+      answer: "Elle la signe Léa, tout court, comme en 1990. Le dimanche, la lettre fait la Une, ce qui n'était jamais arrivé."
+    right:
+      label: "Du virage"
+      effects: {direction: "-", tribunes: "+", set: [h10_lettre_virage], outcome: virage}
+      answer: "« Le virage », en bas de la page. Dans la semaine, trois mille personnes la signent au stylo, dans la marge."
+
+  - id: pr.h10.le.dictaphone_nino
+    roles: [president]
+    arc: presse
+    tags: [presse, objet]
+    speaker: lea
+    lieu: rue
+    tone: strategique
+    once: true
