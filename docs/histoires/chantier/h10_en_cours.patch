+        reponse: "Vous comptez à trois, à voix haute, et tombez sur trois nombres. La petite les note tous les trois sur sa main, au stylo."
+        effets: {jauges: {tribunes: 1}}
+      - label: "Demandez au maçon"
+        reponse: "« Lui, il compte celles qui sont faites. Nous, celles qui restent. Ça ne fait jamais pareil. »"
+
+  - id: h10.sc.pigeons
+    titre: "Les pigeons du square"
+    roles: [president]
+    lieu: square
+    tranches: [aprem]
+    qui: mere_mbako
+    si: "flag('histoire_h10') && flag('h10_mbako_visite')"
+    texte: "Square des Lilas. Une vieille dame en manteau bleu nourrit les pigeons avec méthode. Elle te reconnaît : « Mon fils a écrit une loi. Je la relis le soir. Je ne la comprends pas. »"
+    choix:
+      - label: "Je la lui explique"
+        reponse: "Les franchises, les marches, la date. Elle hoche la tête à chaque phrase. « Alors il a fait ça pour huit clubs. Il a toujours aimé les petits nombres. »"
+      - label: "Moi non plus"
+        reponse: "« Ça me rassure. » Elle jette le reste du pain d'un coup. Les pigeons s'envolent ensemble, vers la Nord."
+
+# Les phrases d'action du match du samedi, propres au livre (placeholders de
+# ville.yaml `match` : {Qui} {qui} {score} {adv} {Adv} {gardien} {Gardien}).
+match_textes:
+  pour:
+    - {texte: "{Qui} marque, et la voix des haut-parleurs dit « magnifique ». Au premier rang de la Nord, un vieux se bouche une oreille : {score}.", si: "flag(histoire_h10) && flag(h10_voix_gardee)"}
+    - {texte: "{Qui} marque devant la Nord. Trois mille masques de carton se lèvent d'un seul geste, sans un cri : {score}.", si: "flag(histoire_h10) && flag(h10_gege_mort)"}
+    - {texte: "But de {qui}. Les tambours de Nino repartent à contretemps, puis le stade les rattrape : {score}.", si: "flag(histoire_h10)"}
+    - {texte: "{Qui} trompe le gardien de {adv}. Au pied de l'escalier nord, le maçon lève sa truelle comme un drapeau : {score}.", si: "flag(histoire_h10) && flag(h10_escalier)"}
+  contre:
+    - {texte: "{Adv} marque. Dans ta poche, le clapet vibre une fois, une seule, comme un applaudissement : {score}.", si: "flag(histoire_h10)"}
+    - {texte: "But de {adv}. La voix des haut-parleurs dit « magnifique » quand même ; la Nord la siffle plus fort que le buteur : {score}.", si: "flag(histoire_h10) && flag(h10_voix_gardee)"}
+    - {texte: "Leur avant-centre marque au pied de la Nord. Les masques de Gégé ne bougent pas ; on ne sait pas s'ils ont vu : {score}.", si: "flag(histoire_h10) && flag(h10_gege_mort)"}
diff --git a/packages/tools/bin/_h10_lire.dart b/packages/tools/bin/_h10_lire.dart
new file mode 100644
index 0000000..b4403f1
--- /dev/null
+++ b/packages/tools/bin/_h10_lire.dart
@@ -0,0 +1,87 @@
+// Outil jetable (histoire 10) : une carrière en clair, textes compris.
+// Supprimé avant le commit.
+import 'dart:io';
+
+import 'package:fusible_core/fusible_core.dart';
+
+int mul32(int a, int b) => (a * b) & 0xFFFFFFFF;
+
+double danger(int v) {
+  final d = (v - 50).abs();
+  if (d <= 20) return d / 20.0;
+  return 1 + (d - 20) * (d - 20) / 15.0;
+}
+
+bool balancer(GameState s, int step) {
+  final p = s.pending!;
+  if (p.single) return true;
+  double score(Map<String, int> deltas) {
+    double total = 0;
+    for (final g in ['vestiaire', 'tribunes', 'direction', 'caisse']) {
+      final projected = ((s.gauges[g] ?? 50) + (deltas[g] ?? 0)).clamp(0, 100);
+      total += danger(projected);
+    }
+    return total;
+  }
+
+  final l = score(p.leftEffects.gauges);
+  final r = score(p.rightEffects.gauges);
+  if ((l - r).abs() < 0.001) return step % 2 == 0;
+  return r < l;
+}
+
+bool humanLike(GameState s, int step) {
+  final err = (((s.rngState >> 3) ^ mul32(step, 2654435761)) & 0x7FFFFFFF) % 100 < 18;
+  final base = balancer(s, step);
+  return err ? !base : base;
+}
+
+void main(List<String> args) {
+  final content = loadContentFromJson(File('content/build/content.json').readAsStringSync());
+  final engine = Engine(content);
+  if (args[0] == 'find') {
+    final seen = <String, List<int>>{};
+    for (var seed = 1; seed <= 400; seed++) {
+      var s = engine.start(seed, postulat: 9);
+      int step = 0;
+      while (!s.over && step < 2000) {
+        final right = humanLike(s, step++);
+        s = engine.choose(s, right);
+      }
+      final k = '${s.endingId} D${s.world.division}';
+      (seen[k] ??= []).add(seed);
+    }
+    for (final e in seen.entries) {
+      stdout.writeln('${e.key} : ${e.value.take(6).join(' ')} (${e.value.length})');
+    }
+    return;
+  }
+  final seed = int.parse(args[0]);
+  var s = engine.start(seed, postulat: 9);
+  int step = 0;
+  while (!s.over && step < 2000) {
+    final p = s.pending!;
+    final right = humanLike(s, step++);
+    final g = s.gauges;
+    final head = 'S${s.season} c${s.slot.toString().padLeft(2)} ${p.kind}${p.speaker == null ? '' : ' [${p.speaker}]'} ${p.id}';
+    final skip = const {'match', 'cup'}.contains(p.kind);
+    if (!skip) {
+      stdout.writeln('— $head  (v${g['vestiaire']} t${g['tribunes']} d${g['direction']} c${g['caisse']})');
+      stdout.writeln('  ${p.text}');
+      if (p.kind == 'bilan_une') {
+        stdout.writeln('  UNE : ${p.payload['titre'] ?? ''} — ${p.payload['sous'] ?? ''}');
+      }
+      final label = right ? p.rightLabel : p.leftLabel;
+      final ans = right ? p.payload['answerRight'] : p.payload['answerLeft'];
+      stdout.writeln('  → ${p.single ? '(un bouton) ' : ''}$label${ans == null ? '' : ' : $ans'}');
+    }
+    s = engine.choose(s, right);
+  }
+  final e = s.endingId;
+  stdout.writeln('== FIN : $e · saison ${s.season}');
+  final end = content.endings[e];
+  if (end != null) {
+    stdout.writeln('  ${end.title}');
+  }
+  stdout.writeln('  drapeaux h10 : ${(s.flags.where((f) => f.startsWith('h10_')).toList()..sort()).join(' ')}');
+}
diff --git a/packages/tools/bin/_h10_stats.dart b/packages/tools/bin/_h10_stats.dart
new file mode 100644
index 0000000..f52f93f
--- /dev/null
+++ b/packages/tools/bin/_h10_stats.dart
@@ -0,0 +1,177 @@
+// Outil jetable (histoire 10) : statistiques de carrière du postulat 9.
+// Supprimé avant le commit.
+import 'dart:io';
+
+import 'package:fusible_core/fusible_core.dart';
+
+int mul32(int a, int b) => (a * b) & 0xFFFFFFFF;
+
+double danger(int v) {
+  final d = (v - 50).abs();
+  if (d <= 20) return d / 20.0;
+  return 1 + (d - 20) * (d - 20) / 15.0;
+}
+
+bool balancer(GameState s, int step) {
+  final p = s.pending!;
+  if (p.single) return true;
+  double score(Map<String, int> deltas) {
+    double total = 0;
+    for (final g in ['vestiaire', 'tribunes', 'direction', 'caisse']) {
+      final projected = ((s.gauges[g] ?? 50) + (deltas[g] ?? 0)).clamp(0, 100);
+      total += danger(projected);
+    }
+    return total;
+  }
+
+  final l = score(p.leftEffects.gauges);
+  final r = score(p.rightEffects.gauges);
+  if ((l - r).abs() < 0.001) return step % 2 == 0;
+  return r < l;
+}
+
+bool humanLike(GameState s, int step) {
+  final err = (((s.rngState >> 3) ^ mul32(step, 2654435761)) & 0x7FFFFFFF) % 100 < 18;
+  final base = balancer(s, step);
+  return err ? !base : base;
+}
+
+int seedOfRun(int i) => i * 2654435761 & 0x7FFFFFFF;
+
+void main(List<String> args) {
+  final runs = args.isNotEmpty ? int.parse(args[0]) : 500;
+  final content = loadContentFromJson(File('content/build/content.json').readAsStringSync());
+  final engine = Engine(content);
+  final endings = <String, int>{};
+  final endingsBySeason = <String, int>{};
+  final s2rank = <int, int>{};
+  final s3div = <int, int>{};
+  final assembly = <String, int>{};
+  final gaugeSum = <int, Map<String, double>>{};
+  final gaugeN = <int, int>{};
+  final flagsAtEnd = <String, int>{};
+  int reachS3 = 0;
+  const watch = [
+    'h10_marche_ouverte', 'h10_marche_muree', 'h10_nino_retourne', 'h10_photo_raccrochee', 'h10_defaite_promise',
+    'h10_lettre_gardee', 'h10_lettre_nino', 'h10_enregistrement', 'h10_enquete', 'h10_clapet_nino', 'h10_gege_mort',
+    'h10_truelle_payee', 'h10_truelle_sale', 'h10_enveloppe_gardee', 'h10_helico', 'h10_brac_vendu', 'h10_owen_vire',
+  ];
+  int gegeGe2 = 0;
+  final carryDist = <String, int>{};
+  final overdue = <String, int>{};
+  final rxLost = <String, int>{};
+  final tones = <String, int>{};
+  final nouv = <int, int>{};
+  final s2slot = <String, int>{};
+  final s2count = <int, int>{};
+  var curS2 = 0;
+  final stepsBySeason = <int, int>{};
+  final overdueBySeason = <int, int>{};
+  final carryArcs = <String, int>{};
+  for (int i = 0; i < runs; i++) {
+    var s = engine.start(seedOfRun(i), postulat: 9);
+    int step = 0;
+    int lastSeasonSeen = -1;
+    while (!s.over && step < 2000) {
+      final p = s.pending!;
+      if (s.season != lastSeasonSeen && p.kind == 'objective') {
+        lastSeasonSeen = s.season;
+        final m = gaugeSum.putIfAbsent(s.season, () => {});
+        for (final g in s.gauges.keys) {
+          m[g] = (m[g] ?? 0) + s.gauges[g]!;
+        }
+        gaugeN[s.season] = (gaugeN[s.season] ?? 0) + 1;
+        if (s.season == 1 || s.season == 2) {
+          final live = <String>[];
+          for (final id in s.arcs.keys.toList()..sort()) {
+            final st = s.arcs[id]!;
+            final a = content.arcs[id];
+            if (a == null || a.kind != 'serie') continue;
+            if (st.status == 'armed' || st.status == 'active') live.add('$id:${st.status}');
+          }
+          carryDist['S${s.season} ${live.length}'] = (carryDist['S${s.season} ${live.length}'] ?? 0) + 1;
+          for (final x in live) {
+            carryArcs['S${s.season} $x'] = (carryArcs['S${s.season} $x'] ?? 0) + 1;
+          }
+        }
+        if (s.season == 3) {
+          reachS3++;
+          s2rank[s.world.rangFinal] = (s2rank[s.world.rangFinal] ?? 0) + 1;
+          s3div[s.world.division] = (s3div[s.world.division] ?? 0) + 1;
+          if ((s.relations['gege'] ?? 0) >= 2) gegeGe2++;
+        }
+      }
+      if (p.kind == 'narrative') {
+        final kind = p.payload['kind'] as String? ?? 'routine';
+        final band = (p.payload['band'] as num?)?.toInt() ?? 0;
+        final tone = p.payload['tone'] as String? ?? 'leger';
+        tones['S${s.season} $tone'] = (tones['S${s.season} $tone'] ?? 0) + 1;
+        if (kind == 'nouvelle') nouv[s.season] = (nouv[s.season] ?? 0) + 1;
+        if (s.season == 2 && kind == 'nouvelle') curS2++;
+        if (s.season == 2 && (s.slot == 13 || s.slot == 9 || s.slot == 10 || s.slot == 3 || s.slot == 6)) {
+          final k = 'slot ${s.slot} ${kind == 'nouvelle' ? 'nouvelle' : '$kind ${p.id}'}';
+          s2slot[k] = (s2slot[k] ?? 0) + 1;
+        }
+        if (kind == 'etape' || kind == 'chaine' || kind == 'palier') {
+          stepsBySeason[s.season] = (stepsBySeason[s.season] ?? 0) + 1;
+          if (band == 6) {
+            overdueBySeason[s.season] = (overdueBySeason[s.season] ?? 0) + 1;
+            final k = 'S${s.season} ${p.id}';
+            overdue[k] = (overdue[k] ?? 0) + 1;
+          }
+        }
+      }
+      if (p.kind == 'narrative' && p.id.startsWith('pr.h10.d1_assemblee')) {
+        assembly[p.id] = (assembly[p.id] ?? 0) + 1;
+      }
+      final right = humanLike(s, step++);
+      final before = s.stats['miss_reaction_role'] ?? 0;
+      final beforeSt = s.stats['miss_reaction_statut'] ?? 0;
+      final pid = p.kind == 'bilan_une' ? '${p.id} ${s.lastUne}' : p.id;
+      s = engine.choose(s, right);
+      if ((s.stats['miss_reaction_role'] ?? 0) > before) rxLost['role $pid'] = (rxLost['role $pid'] ?? 0) + 1;
+      if ((s.stats['miss_reaction_statut'] ?? 0) > beforeSt) rxLost['statut $pid'] = (rxLost['statut $pid'] ?? 0) + 1;
+    }
+    if (s.season >= 3) s2count[curS2] = (s2count[curS2] ?? 0) + 1;
+    curS2 = 0;
+    final e = s.endingId ?? '?';
+    endings[e] = (endings[e] ?? 0) + 1;
+    endingsBySeason['S${s.season} $e'] = (endingsBySeason['S${s.season} $e'] ?? 0) + 1;
+    for (final f in watch) {
+      if (s.flags.contains(f)) flagsAtEnd[f] = (flagsAtEnd[f] ?? 0) + 1;
+    }
+  }
+  String pc(int n) => '${(100 * n / runs).toStringAsFixed(1)} %';
+  stdout.writeln('== $runs carrières, postulat 9');
+  stdout.writeln('fins :');
+  final es = endings.entries.toList()..sort((a, b) => b.value.compareTo(a.value));
+  for (final e in es) {
+    stdout.writeln('  ${e.key.padRight(22)} ${pc(e.value)}');
+  }
+  stdout.writeln('fins par saison :');
+  final ebs = endingsBySeason.entries.toList()..sort((a, b) => a.key.compareTo(b.key));
+  for (final e in ebs) {
+    stdout.writeln('  ${e.key.padRight(28)} ${e.value}');
+  }
+  stdout.writeln('jauges moyennes à l\'objectif :');
+  for (final se in gaugeSum.keys.toList()..sort()) {
+    final n = gaugeN[se]!;
+    final m = gaugeSum[se]!;
+    stdout.writeln('  S$se (n=$n) ${m.entries.map((e) => '${e.key} ${(e.value / n).toStringAsFixed(0)}').join(' · ')}');
+  }
+  stdout.writeln('atteignent S3 : ${pc(reachS3)} · rang final S2 : $s2rank · division S3 : $s3div · Gégé ≥ 2 : $gegeGe2');
+  stdout.writeln('assemblée : $assembly');
+  stdout.writeln('report à l\'ouverture de saison : $carryDist');
+  final ca = carryArcs.entries.toList()..sort((a, b) => b.value.compareTo(a.value));
+  stdout.writeln('  ${ca.map((e) => '${e.key} ${e.value}').join(' · ')}');
+  stdout.writeln('étapes servies échues : ${stepsBySeason.keys.map((k) => 'S$k ${overdueBySeason[k] ?? 0}/${stepsBySeason[k]}').join(' · ')}');
+  final od = overdue.entries.toList()..sort((a, b) => b.value.compareTo(a.value));
+  stdout.writeln('  ${od.take(30).map((e) => '${e.key} ${e.value}').join(' · ')}');
+  final rl = rxLost.entries.toList()..sort((a, b) => b.value.compareTo(a.value));
+  stdout.writeln('réactions perdues : ${rl.take(20).map((e) => '${e.key} ${e.value}').join(' · ')}');
+  stdout.writeln('tons : ${(tones.keys.toList()..sort()).map((k) => '$k ${tones[k]}').join(' · ')}');
+  stdout.writeln('Nouvelles : $nouv · S2 (carrières arrivées en S3) : $s2count');
+  final ss = s2slot.entries.toList()..sort((a, b) => b.value.compareTo(a.value));
+  stdout.writeln('  ${ss.take(25).map((e) => '${e.key} ${e.value}').join(' · ')}');
+  stdout.writeln('drapeaux en fin : ${flagsAtEnd.entries.map((e) => '${e.key} ${pc(e.value)}').join(' · ')}');
+}
