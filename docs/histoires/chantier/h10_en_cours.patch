+    lieu: buvette
+    tone: leger
+    once: true
+    text: "Nino lit au micro : « Socio 212, mille quatre cent trois cartes. » Au premier rang, Gégé, socio numéro 1, te fait signe d'approcher : « Monte-nous avant qu'ils ferment, et je meurs content. »"
+    left:
+      label: "Je vous le promets"
+      effects: {direction: "-", tribunes: "+", relation: {gege: 1}, set: [h10_promesse_gege]}
