+    right:
+      label: "Effacez cette ligne"
+      effects: {tribunes: "-", caisse: "+", var: {cadeau_villa: "+1"}, set: [h10_ligne_archivee]}
+      answer: "« On n'efface rien, chez nous. On archive. » Il tape trois touches. La ligne quitte l'écran, pas la banque."
+
+  - id: pr.h10.pro4_banque
+    roles: [president]
+    arc: caisse
+    tags: [caisse, sponsors]
+    lieu: banque
+    tone: leger
+    once: true
+    text: "Banque Aubérivoise. Le conseiller tourne l'écran : la trésorerie du club tient jusqu'en février. Ligne du 2 septembre : tes dettes et l'hypothèque de ta villa, soldées par Rive Capital."
+    left:
+      label: "Imprimez-moi le relevé"
+      effects: {direction: "-", var: {cadeau_villa: "+1"}, set: [h10_releve]}
+      answer: "L'imprimante met un temps fou. Il plie la feuille en trois et la glisse dans une enveloppe à fenêtre, comme une facture."
+    right:
+      label: "Effacez cette ligne"
