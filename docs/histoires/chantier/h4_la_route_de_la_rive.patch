+# HISTOIRE 4 — « La Route de la Rive » : les ancres du script (l'arc
+# `jp.fin.dernier_contrat`, content/arcs/joueur/fdc_script.yaml). Chaque carte
+# est la première variante de son étape ; les variantes historiques `jp.fin.*`
+# restent derrière elle, en secours jamais servi.
+#
+# Ce que tiennent ces douze ancres : le 14 mai 1984. Une fête au pont après la
+# montée ; une voiture du club sur la route de la Rive à deux heures ; une
+# fille de quinze ans sur sa mobylette. On a dit au joueur qu'il conduisait et
+# qu'elle était morte. Titi Bréhaut conduisait ; Sandrine Lavergne a vécu. On
+# ne montre jamais la nuit elle-même : l'avant (la fête, le départ du pont à
+# une heure cinquante) et l'après (la pierre, les fleurs, le silence).
+#
+# Bréhaut et Sabatier ne disent jamais `{toi}` : leur adresse neutre est
+# « petit », fausse à trente et un ans et fausse pour une joueuse. Le joueur
+# peut être une femme : aucun accord masculin, `{pg, select, f{e} other{}}`.
+cards:
+  # =================================================== S0 · slot 1 · le restaurant
+  # La dernière année. Fardelli tient l'agenda depuis 1984, y compris le 14 mai.
+  # Les deux sorties ouvrent le livre : le premier morceau (créneaux 4-5) et la
+  # première infiltration (6-7).
+  - id: jp.h4.a1_derniere_annee
+    roles: [joueur]
+    arc: contrat
+    tags: [agents, mercato]
+    speaker: fardelli
+    tone: leger
+    text: "Fardelli coupe sa viande sans te regarder : « Dernière année, {toi}. Je m'occupe du contrat, toi du genou. Et le 14 mai, comme chaque année, je t'ai bloqué la journée. »"
+    left:
+      label: "Garde le mandat"
+      effects: {direction: "+", caisse: "-", relation: {fardelli: 1}, set: [agent_fardelli], schedule: [{card: jp.h4.morceaux.premier, in: [3, 5]}, {card: jp.h4.route.piqure, in: [4, 7]}]}
+      answer: "Il écrit « 14/5 » dans son agenda, à l'encre, sur une page déjà marquée au crayon. Puis il commande deux cafés et n'en boit qu'un."
+    right:
+      label: "Je cherche sans toi"
+      effects: {direction: "-", vestiaire: "+", relation: {fardelli: -1}, set: [sans_agent], schedule: [{card: jp.h4.morceaux.premier, in: [3, 5]}, {card: jp.h4.route.piqure, in: [4, 7]}]}
+      answer: "Il replie la nappe sur le contrat. « Sans moi, le 14 mai, qui t'emmène ? » Il paie l'addition sans regarder le montant."
+
+  - id: jp.h4.a1_derniere_annee_genou
