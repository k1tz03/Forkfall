diff --git a/content/cards/joueur/h4_decor.yaml b/content/cards/joueur/h4_decor.yaml
new file mode 100644
index 0000000..d611127
--- /dev/null
+++ b/content/cards/joueur/h4_decor.yaml
@@ -0,0 +1,291 @@
+# HISTOIRE 4 — « La Route de la Rive » : le décor. Des cartes du sac (sans
+# intrigue), qui ne se tirent que dans ce livre (`flag('histoire_h4')`) et une
+# fois chacune. Elles lisent ce que le joueur a déjà vu : le panneau planté
+# au bord de la route, la chevalière du rêve, la standardiste du square.
+#
+# Le décor donne du souffle entre deux coups : Mbako qui ne demande rien sur
+# 1984, Sacha qui joue à gauche ou à droite, le gardien qui taille des
+# chrysanthèmes gelés. Personne n'accorde rien au joueur.
+cards:
+  # ------------------------------------------------- Sacha
+  - id: jp.h4.d.sacha_carrefour
+    roles: [joueur]
+    arc: famille
+    tags: [famille, decor]
+    speaker: sacha
+    lieu: parking
+    tone: leger
+    once: true
+    when: "flag('histoire_h4') && !flag('divorce')"
+    text: "Feu rouge, carrefour de la Mairie. Sacha, attachée à l'arrière, tape sur ton appuie-tête : « À gauche ou à droite, {toi} ? C'est moi qui choisis, aujourd'hui. »"
+    left:
+      label: "À gauche"
+      effects: {vestiaire: "+", relation: {sacha: -1}}
+      answer: "« Non ! C'est moi qui choisis ! » Le feu passe au vert. Derrière, quelqu'un klaxonne. Tu tournes à gauche quand même."
+    right:
+      label: "Choisis, toi"
+      effects: {tribunes: "+", relation: {sacha: 1}}
+      answer: "« À droite ! » Tu tournes à droite. Elle applaudit comme au stade. Ce n'est pas le chemin de l'école ; tu le prends quand même."
+
+  - id: jp.h4.d.sacha_freine
+    roles: [joueur]
+    arc: famille
+    tags: [famille, decor]
+    speaker: sacha
+    lieu: domicile
+    tone: leger
+    once: true
+    when: "flag('histoire_h4') && flag('h4_reve_freine') && !flag('divorce')"
+    text: "Sacha joue sur le tapis du salon, une petite voiture dans chaque main. Elle les fait foncer l'une vers l'autre en criant : « Freine ! Freine ! »"
+    left:
+      label: "Où as-tu appris ça ?"
+      effects: {vestiaire: "-", relation: {sacha: -1}}
+      answer: "« C'est toi qui le dis, la nuit. À travers le mur. » Elle refait foncer les deux voitures. Elles ne se touchent jamais."
+    right:
+      label: "Je joue avec elle"
+      effects: {tribunes: "+", relation: {sacha: 1}}
+      answer: "Tu prends une voiture, elle prend l'autre. « Freine ! » Tu freines. Elle rit. Tu ris aussi, une seconde trop tard."
+
+  # ------------------------------------------------- le tabac du Quai
+  - id: jp.h4.d.lavergne_monnaie
+    roles: [joueur]
+    arc: famille
+    tags: [decor]
+    speaker: lavergne
+    tone: leger
+    once: true
+    when: "flag('histoire_h4') && !flag('h4_fiche_hopital')"
+    text: "Tabac du Quai, sept heures. Le buraliste te tend L'Écho plié et ta monnaie, sans un mot, comme chaque matin depuis 1985. Ce matin, il garde la dernière pièce dans sa main une seconde de trop."
+    left:
+      label: "Je compte la monnaie"
+      effects: {direction: "+"}
+      answer: "Le compte est juste. Il est toujours juste. Tu ne sais pas pourquoi tu as compté, ni pourquoi il te regardait le faire."
+    right:
+      label: "Je pars sans compter"
+      effects: {tribunes: "+"}
