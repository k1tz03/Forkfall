@@ -0,0 +1,165 @@
+# HISTOIRE 4 — « La Route de la Rive » : les manchettes du livre. Schéma et
+# règles : en-tête de content/unes.yaml.
+#
+# La presse ne sait que ce qu'on lui apporte : ce que voit un photographe au
+# carré ancien, ce qu'un corbeau dépose à la rédaction, ce que Massenet garde
+# dans un tiroir, ce que l'auto-école plante au bord de la route. Les
+# manchettes de trace lisent `flag('x') && journal_has('x')` (la ligne de
+# l'Almanach de la saison) ; celles d'état lisent la saison. Bande 3 et poids
+# fort : le livre passe devant le contrat au rabais (une.fin.rabais), pas
+# devant une descente. Aucune ne dit le mot du classement.
+unes:
+  # ---------------------------------------------------- saison 1990-1991
+  - id: une.h4.carre_ancien
+    postulats: [fin_de_contrat]
+    roles: [joueur]
+    journal: gazette
+    priority: 3
+    poids: 3.0
+    when: "flag('h4_quatorze_mai') && journal_has('h4_quatorze_mai')"
+    titre: "{NOM}, LE 14 MAI, AU CARRÉ ANCIEN"
+    sous: "Chaque année la même date, le même bouquet, la même allée. Notre photographe a suivi {prenom} {nom} jusqu'à la tombe d'un certain Jules Bertin, mort en 1983. On se demande."
+    sujet: jp.fin.dernier_contrat
+    photo: jp.h4.a4_quatorze_mai
+
+  - id: une.h4.aiguille
+    postulats: [fin_de_contrat]
+    roles: [joueur]
+    journal: quotidien
+    priority: 2
+    when: "flag('h4_infiltration') && journal_has('h4_infiltration')"
+    titre: "{NOM} JOUE SUR UNE AIGUILLE"
+    sous: "Une infiltration à l'automne, une autre au printemps. Le docteur du club refuse de commenter. Le genou, lui, a fini la saison."
+    sujet: jp.h4.route
+    photo: jp.h4.route.piqure
+
+  - id: une.h4.panneau
+    postulats: [fin_de_contrat]
+    roles: [joueur]
+    journal: echo
+    priority: 2
+    poids: 2.0
+    when: "flag('h4_panneau_toi') && season == 0"
+    titre: "{NOM} À CENT MÈTRES DU PONT"
+    sous: "L'auto-école de la Rive a planté son panneau à l'entrée de la route : quatre mètres, un sourire, « Le permis, c'est la vie ». Les anciens de 1984 ralentissent en passant."
+    photo: jp.h4.re.fardelli_panneau
+
+  - id: une.h4.capitaine_panneau
+    postulats: [fin_de_contrat]
+    roles: [joueur]
+    journal: echo
+    priority: 2
+    poids: 2.0
+    when: "flag('h4_panneau_brehaut') && season == 0"
+    titre: "LE CAPITAINE VEILLE SUR LA ROUTE"
+    sous: "Titi Bréhaut prête son visage à l'auto-école de la Rive. « Si un seul gamin ralentit, ça vaut le coup », dit-il. Le panneau est à cent mètres du pont."
+
+  - id: une.h4.archives
+    postulats: [fin_de_contrat]
+    roles: [joueur]
+    journal: echo
+    priority: 1
+    when: "flag('h4_photo_archives') && season == 0"
+    titre: "LES ANCIENS DE 1984 PARTENT À LA CAVE"
+    sous: "Les peintres ont décroché les photos du couloir de {club}. Celle de la fête du pont dort dans un carton ; {prenom} {nom} n'a pas voulu la garder."
+
+  # ---------------------------------------------------- saison 1991-1992
+  - id: une.h4.lettre
+    postulats: [fin_de_contrat]
+    roles: [joueur]
+    journal: echo
+    priority: 3
+    poids: 2.0
+    when: "flag('h4_corbeau') && journal_has('h4_corbeau')"
+    titre: "UNE LETTRE SANS TIMBRE À LA RÉDACTION"
+    sous: "« Demandez-lui où il était le 14 mai 1984. » L'Écho ne publie pas les lettres anonymes. Il les garde dans un tiroir, avec d'autres papiers de cette année-là."
+    sujet: jp.h4.deux_lignes
+    photo: jp.h4.sb.corbeau
+
+  - id: une.h4.deux_lignes
+    postulats: [fin_de_contrat]
+    roles: [joueur]
+    journal: echo
+    priority: 3
+    poids: 2.0
+    when: "flag('h4_deux_lignes') && journal_has('h4_deux_lignes')"
+    titre: "LES DEUX LIGNES DU MILIEU"
+    sous: "Pierre Massenet a rouvert un tiroir de 1984. « Transportée vivante », disait sa copie, entre huit lignes barrées. Il n'en dira pas plus sans la onzième."
+    sujet: jp.h4.deux_lignes
+    photo: jp.h4.deux_lignes.tiroir
+
+  - id: une.h4.standard
+    postulats: [fin_de_contrat]
+    roles: [joueur]
+    journal: gazette
+    priority: 3
+    poids: 2.0
+    when: "flag('h4_standard_vu') && journal_has('h4_standard_vu')"
+    titre: "{NOM} AU STANDARD DE LA RIVE"
+    sous: "Un soir de semaine, sans valise, au comptoir du standard de l'hôtel de la Rive. La standardiste n'a pas levé les yeux. Le veilleur de nuit, si."
+    sujet: jp.h4.standard
+    photo: jp.h4.standard.standard
+
+  - id: une.h4.capot_grave
+    postulats: [fin_de_contrat]
+    roles: [joueur]
+    journal: gazette
+    priority: 3
+    poids: 2.0
+    when: "flag('h4_capot_grave') && journal_has('h4_capot_grave')"
+    titre: "14-5-84 SUR LE CAPOT DE {NOM}"
+    sous: "Gravé à la clé, sur le parking du stade. Une date que personne ne comprend, sauf ceux qui ne la disent pas. Le club n'a pas porté plainte."
+    photo: jp.h4.sb.capot_grave
+
+  - id: une.h4.ampoules
+    postulats: [fin_de_contrat]
+    roles: [joueur]
+    journal: gazette
+    priority: 3
+    when: "flag('h4_sp_serene') && journal_has('h4_sp_serene')"
+    titre: "LES AMPOULES DE {NOM}"
+    sous: "Un visiteur des Laboratoires Sérène, au bar de l'hôtel de la Rive, une enveloppe sous la soucoupe. Le docteur du club dit qu'il n'a rien vu. Il ment mal."
+    photo: jp.h4.route.serene
+
+  - id: une.h4.bertin
+    postulats: [fin_de_contrat]
+    roles: [joueur]
+    journal: echo
+    priority: 2
+    when: "flag('h4_pas_de_tombe') && journal_has('h4_pas_de_tombe')"
+    titre: "QUI ÉTAIT JULES BERTIN ?"
+    sous: "Né en 1902, mort en 1983, sans famille, carré ancien. Depuis 1985, il reçoit des chrysanthèmes chaque 14 mai. Monsieur Abel, le gardien, tient le registre."
+    sujet: jp.h4.bertin
+    photo: jp.h4.bertin.fardelli
+
+  # ---------------------------------------------------- saison 1992-1993 et après
+  - id: une.h4.volant
+    postulats: [fin_de_contrat]
+    roles: [joueur]
+    journal: echo
+    priority: 4
+    when: "flag('h4_nom_imprime') && journal_has('h4_nom_imprime')"
+    titre: "QUI ÉTAIT AU VOLANT ?"
+    sous: "Neuf ans après la fête du pont, une onzième ligne : un nom, en page sept, sous un titre qui ne disait rien. Le kiosque du quai a tout vendu avant midi."
+    sujet: jp.h4.deux_lignes
+    photo: jp.h4.deux_lignes.epreuve
+
+  - id: une.h4.silence
+    postulats: [fin_de_contrat]
+    roles: [joueur]
+    journal: echo
+    priority: 4
+    poids: 2.0
+    when: "flag('h4_silence') && journal_has('h4_silence')"
+    titre: "JUBILÉ : LE SILENCE DU ROND CENTRAL"
+    sous: "Le stade debout, le micro tendu, et {prenom} {nom} l'a rendu sans un mot. Au premier rang de la tribune Est, un fauteuil est reparti avant les applaudissements."
+    photo: jp.h4.a11_silence
+
+  - id: une.h4.route
+    postulats: [fin_de_contrat]
+    roles: [joueur]
+    journal: quotidien
+    priority: 2
+    when: "flag('h4_silence') && season >= 3"
+    titre: "LA ROUTE DE LA RIVE"
+    sous: "{prenom} {nom} joue encore, ne parle plus aux journalistes, et prend la route du haut pour rentrer. Au carré ancien, la tombe de Jules Bertin a toujours ses fleurs."
