+          - { id: sl.h7.s4_douze_pull, if: "flag('h7_pull_perdu')" }
+          - { id: sl.h7.s4_douze_double, if: "flag('h7_double_mere')" }
+          - { id: sl.h7.s4_douze_hall, if: "flag('h7_double_refuse')" }
+          - { id: sl.h7.s4_douze_standard, if: "flag('h7_mere_standard')" }
