diff --git a/packages/tools/bin/h7_lire_tmp.dart b/packages/tools/bin/h7_lire_tmp.dart
new file mode 100644
index 0000000..0a6b8f8
--- /dev/null
+++ b/packages/tools/bin/h7_lire_tmp.dart
@@ -0,0 +1,74 @@
+// TEMPORAIRE — relecture en clair d'une carrière (Histoire 7). Jamais commité.
+// dart run packages/tools/bin/h7_lire_tmp.dart <graine> <politique: humain|gauche|hasard> [saisons]
+import 'dart:io';
+
+import 'package:fusible_core/fusible_core.dart';
+
+double _danger(int v) {
+  final d = (v - 50).abs();
+  if (d <= 20) return d / 20.0;
+  return 1 + (d - 20) * (d - 20) / 15.0;
+}
+
+bool _balancer(GameState s, int step) {
+  final p = s.pending!;
+  if (p.single) return true;
+  double score(Map<String, int> deltas) {
+    double total = 0;
+    for (final g in ['vestiaire', 'tribunes', 'direction', 'caisse']) {
+      final projected = ((s.gauges[g] ?? 50) + (deltas[g] ?? 0)).clamp(0, 100);
+      total += _danger(projected);
+    }
+    return total;
+  }
+
+  final l = score(p.leftEffects.gauges);
+  final r = score(p.rightEffects.gauges);
+  if ((l - r).abs() < 0.001) return step % 2 == 0;
+  return r < l;
+}
+
+void main(List<String> args) {
+  final seed = int.parse(args[0]);
+  final pol = args.length > 1 ? args[1] : 'humain';
+  final maxSeasons = args.length > 2 ? int.parse(args[2]) : 4;
+  final content = loadContentFromJson(File('content/build/content.json').readAsStringSync());
+  final engine = Engine(content);
+  var s = engine.start(seed, postulat: 6);
+  var step = 0;
+  while (!s.over && s.pending != null && s.season < maxSeasons && step < 400) {
+    final p = s.pending!;
+    bool right;
+    if (pol == 'gauche') {
+      right = false;
+    } else if (pol == 'hasard') {
+      right = ((s.rngState >> 5) ^ (step * 2654435761)) & 1 == 1;
+    } else {
+      final err = (((s.rngState >> 3) ^ (step * 2654435761)) & 0x7FFFFFFF) % 100 < 18;
+      final base = _balancer(s, step);
+      right = err ? !base : base;
+    }
+    final g = s.gauges;
+    stdout.writeln('S${s.season}·${s.slot.toString().padLeft(2)} [${p.kind}] ${p.id}${p.speaker != null ? ' — ${p.speaker}' : ''}'
+        '   (v${g['vestiaire']} t${g['tribunes']} d${g['direction']} c${g['caisse']})');
+    stdout.writeln('   ${p.text}');
+    if (!p.single) {
+      stdout.writeln('   ← ${p.leftLabel}   |   → ${p.rightLabel}   ⇒ ${right ? 'DROITE' : 'GAUCHE'}');
+    }
+    final ans = right ? p.payload['answerRight'] : p.payload['answerLeft'];
+    if (ans is String && ans.isNotEmpty) stdout.writeln('   » $ans');
+    if (p.kind == 'bilan_une') {
+      stdout.writeln('   UNE : ${p.payload['une']} · ${p.payload['titre'] ?? ''} · ${p.payload['sous'] ?? ''}');
+    }
+    s = engine.choose(s, right);
+    step++;
+  }
+  stdout.writeln('FIN : ${s.endingId ?? '(saisons épuisées)'} · saison ${s.season}');
+  if (s.endingId != null) {
+    stdout.writeln('   ${s.pending?.text ?? ''}');
+  }
+  stdout.writeln('ALMANACH :');
+  for (final e in s.journal) {
+    stdout.writeln('   · ${e.text}');
+  }
+}
