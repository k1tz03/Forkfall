+          - { id: sl.h7.s3_valise_demission, if: "flag('h7_demission_signee')" }
+          - { id: sl.h7.s3_valise_tournoi, if: "flag('h7_phrase_laissee')" }
+          - { id: sl.h7.s3_valise_cardiologue, if: "flag('h7_cardiologue')" }
+          - { id: sl.h7.s3_valise }
+        at: [13, 13]
+        season: 2
