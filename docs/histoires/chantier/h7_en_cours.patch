+          - { id: sl.h7.s5_tableau_ronde, if: "flag('h7_ronde')" }
+          - { id: sl.h7.s5_tableau_seule, if: "flag('h7_confiance')" }
+          - { id: sl.h7.s5_tableau }
+        at: [16, 16]
