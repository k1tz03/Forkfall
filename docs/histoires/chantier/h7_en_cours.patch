+    tags: [vestiaire, decor]
+    speaker: mbako
+    lieu: hotel
+    tone: leger
+    once: true
+    when: "flag('histoire_h7') && !flag('h7_rance_mort')"
+    text: "Mbako apprend aux jeunes à monter l'escalier de l'hôtel deux marches à la fois, sans bruit : « Sandrine entend tout. Mais elle n'écrit que ce qu'on lui dit, {toi}. »"
+    left:
