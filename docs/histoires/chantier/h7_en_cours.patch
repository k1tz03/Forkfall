+    right:
+      label: "Je regarde d'en haut"
+      effects: {direction: "+", tribunes: "-", set: [h7_bougies]}
+      answer: "De ta fenêtre, tu vois les flammes, puis un bras qui se lève dans la même foule. La vitre du 14 éclate. Les bougies, elles, tiennent."
+
+  - id: sl.h7.b2_pierre
+    roles: [selectionneur]
+    arc: vestiaire
