+# Histoire 7 · Chambre 12 — les cartes des soirs (arcs `kind: evenement` de
+# content/arcs/selectionneur/h7_sombres.yaml). Hors du sac, `once`, `sombre`,
+# un `lieu:` par carte : la ville les met en scène le soir, à leur place, sans
+# s'annoncer. La violence arrive d'un coup et hors champ (une vitre qui éclate,
+# une cire cassée) ; la carte d'après est le lendemain.
+#
+# Les deux fins qui peuvent tomber ici (`co_garde_a_vue`) ferment une carrière
+# qui a gardé une preuve pendant l'enquête : la page du cahier de nuit, ou le
+# carnet du petit pris sous les scellés. Le refus est une phrase, pas un geste.
+cards:
+  # ═══════════════════════════════════════════════════ 2011 · Le Corner
+  - id: sl.h7.e0_corner
+    roles: [selectionneur]
+    arc: vestiaire
+    tags: [vestiaire, sombre]
+    speaker: mbako
+    lieu: bar
+    tone: strategique
+    once: true
+    text: "Le Corner, une heure du matin. Mbako au comptoir, un verre devant lui ; à côté, le petit Rancé, un jus d'orange, essoufflé d'avoir monté la rue. Mbako lève son verre : « On fête quoi, {toi} ? »"
+    left:
+      label: "Je les ramène"
+      effects: {direction: "+", vestiaire: "-", set: [h7_corner_ramenes]}
+      answer: "Dans la côte, le petit s'arrête deux fois, la main à plat sur la poitrine : « C'est la côte. » Mbako le porte presque jusqu'à l'hôtel."
+    right:
+      label: "Je prends un verre"
+      effects: {vestiaire: "+", direction: "-", set: [h7_corner_verre]}
+      answer: "Vous trinquez à rien. À deux heures, le petit dort sur la banquette ; Mbako le regarde respirer, longtemps, sans rien dire."
+
+  # ═══════════════════════════════════ 2012 · Les bougies et la pierre
+  - id: sl.h7.b1_bougies
+    roles: [selectionneur]
+    arc: tribune
+    tags: [ultras, tribunes, sombre]
+    speaker: gege
+    lieu: rue
+    tone: strategique
+    once: true
+    text: "Le trottoir de l'hôtel, dix heures. Le virage d'Aubérive pose des bougies pour le gamin du centre. Gégé, une flamme à la main : « Il était d'ici. Vous descendez, ou vous regardez d'en haut ? »"
+    left:
+      label: "Je descends"
+      effects: {tribunes: "+", relation: {gege: 1}, set: [h7_bougies]}
