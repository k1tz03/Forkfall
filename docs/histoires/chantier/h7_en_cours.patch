+      label: "Tu ne dis rien"
+      effects: {vestiaire: "+", direction: "+", set: [h7_ferrol_tait], outcome: tait}
+      answer: "« D'accord. » Il dit « d'accord » comme on avale. Le soir même, il coupe son bracelet de Valdorne, et le jette."
+
+  - id: sl.h7.m3_jeudi
+    roles: [selectionneur]
+    arc: presse
+    tags: [presse]
+    speaker: lea
+    lieu: echo
+    tone: strategique
+    once: true
+    text: "Léa, au téléphone : « Jeudi, la photo sort avec la main. Sans le nom : je n'ai qu'une source. Vous voulez être la deuxième ? »"
+    left:
+      label: "Je serai la deuxième"
+      effects: {tribunes: "+", direction: "-", set: [h7_nom_confirme, h7_questions]}
+      answer: "Le jeudi, la photo sort en page trois, la main et le nom. Le vendredi, Ferrol arrive à l'entraînement avant tout le monde."
+    right:
+      label: "Cherchez ailleurs"
+      effects: {direction: "+", set: [h7_nom_tu]}
+      answer: "Le jeudi, la photo sort sans le nom. En dessous, une ligne : « La sélection n'a pas souhaité répondre. »"
+
+  - id: sl.h7.m3_ferrol_parle
+    roles: [selectionneur]
+    arc: presse
+    tags: [presse]
+    speaker: lea
+    lieu: echo
+    tone: strategique
+    once: true
+    text: "Léa repose le téléphone : « Ferrol est venu ce matin, seul. Jeudi, la photo sort avec la main, son nom, et ce qu'il a dit. Vous ajoutez une phrase ? »"
+    left:
+      label: "Il a eu du courage"
+      effects: {tribunes: "+", vestiaire: "+", set: [h7_nom_confirme]}
