+        effets: {jauges: {tribunes: 1}}
+
+  # ═══════════════════════════════════════════════════════════ 2013
+  - id: h7.sc.livre_or
+    titre: "La page de novembre"
+    roles: [selectionneur]
+    lieu: hotel
+    tranches: [matin]
+    qui: escande
+    si: "flag('histoire_h7') && flag('h7_rance_mort') && annee >= 2012"
