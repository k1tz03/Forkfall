+    - roles: [ds]
+      when: "flag('histoire_h8') && !flag('h8_sans_oreillette') && !flag('h8_voiture_rendue')"
+      text: "Tour de Coupe : {tour}. La voix a déjà joué le match : « Élimination probable, deux à un, à la soixante-dix-huitième minute. » Mbako, lui, ne veut pas savoir la minute."
+      left: "Je la garde pour moi"
+    - roles: [ds]
+      when: "flag('histoire_h8')"
+      speaker: gege
+      text: "Tour de Coupe : {tour}. Personne ne sait comment ça finira, et c'est la première fois depuis longtemps. Gégé a apporté un thermos pour les prolongations, au cas où."
+      left: "Y croire"
+
+  # ══ gm_annonce ══════════════════════════════════════════════════════════
+  gm_annonce:
+    - roles: [ds]
+      when: "flag('histoire_h8') && season == 1 && flag('h8_vaubourg_mort')"
+      text: "GRAND MATCH. Dans la loge, la place de Vaubourg est vide ; quelqu'un y a posé sa canne, en travers du siège. Personne ne s'assied à côté. Coup d'envoi."
+      left: "Coup d'envoi"
+    - roles: [ds]
+      when: "flag('histoire_h8') && season == 0 && flag('h8_kerdal_mort')"
+      text: "GRAND MATCH. Le numéro 4 n'est pas sur la feuille ; le club l'a retiré jusqu'à la fin de la saison. Au virage, une bâche : QUATRE. Rien d'autre. Coup d'envoi."
+      left: "Coup d'envoi"
+    - roles: [ds]
+      when: "flag('histoire_h8') && !flag('h8_sans_oreillette') && !flag('h8_voiture_rendue')"
+      text: "GRAND MATCH. Au coup d'envoi, la voix se tait d'elle-même, pour la première fois depuis août. Elle reprendra à la quatre-vingt-dixième, avec le score. Coup d'envoi."
+      left: "Coup d'envoi"
+
+  # ══ gm_te ═══════════════════════════════════════════════════════════════
+  gm_te:
+    - roles: [ds]
+      when: "flag('histoire_h8') && vars.gm_te_index == 1 && !flag('h8_sans_oreillette') && !flag('h8_voiture_rendue')"
+      text: "{minute}e minute · {score}. La voix : « Remplacez le 8. Fatigue cardiaque : quatre-vingt-onze pour cent. » Sur le banc, Mbako ne te regarde pas. Il regarde le 8."
+      left: "Le 8 sort"
+      right: "Le 8 reste"
+    - roles: [ds]
+      when: "flag('histoire_h8') && vars.gm_te_index == 3"
+      text: "{minute}e minute · {score}. Dernier quart d'heure. Dans la Nord, quelqu'un a allumé un fumigène ; la fumée monte jusqu'à la loge. Tu respires en quatre temps, sans t'en rendre compte."
+      left: "Je descends au bord"
+      right: "Je reste en loge"
+
