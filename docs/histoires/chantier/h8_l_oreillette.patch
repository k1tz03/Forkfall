+    right:
+      label: "Je ne dors pas"
+      effects: {direction: "+"}
+      answer: "« Personne ne dort, dans ce métier. Vous, au moins, vous savez à quelle heure vous ne dormez pas. » Elle paie, sans discuter."
+
+  - id: ds.h8.rt.kara_assurance
