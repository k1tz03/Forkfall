+  # ------------------------------------------- 3 · Les phrases (d'elle)
+  - id: ds.h8.op.phrases_heure
+    roles: [ds]
+    arc: agents
+    tags: [agents, portable]
+    speaker: kara
+    lieu: domicile
+    tone: strategique
+    once: true
+    text: "Trois heures. Inès appelle de son poste, à voix basse : « “Tu refuses toujours à cette heure-ci”, c'est moi. L'écran ne disait rien. Je voulais que tu refuses. Je voulais voir si tu m'écoutais. »"
+    left:
+      label: "Je t'écoutais"
+      effects: {vestiaire: "+", relation: {kara: 1}, set: [h8_ines_aveu], var: {h8_nuits: "+1"}}
