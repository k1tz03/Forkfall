+    tone: leger
+    once: true
+    when: "flag('histoire_h8') && season >= 2"
+    text: "À la buvette, Gégé a débranché l'écran qui affichait le cœur des joueurs pendant les matchs. À sa place, une feuille punaisée, écrite au feutre : ICI, ON REGARDE LE MATCH."
+    left:
+      label: "Je regarde le match"
+      effects: {tribunes: "+", relation: {gege: 1}}
