+    lieu: cabinet
+    tone: leger
+    once: true
+    text: "Le lendemain, Ober t'arrête dans le couloir, ton dossier sous le bras : « Votre montre ne transmet plus depuis hier soir. Le fonds me demande pourquoi. Je lui dis que vous l'avez perdue ? »"
+    left:
+      label: "Dites-le"
+      effects: {direction: "+", relation: {ober: 1}}
