+    left:
+      label: "Je le monte"
+      effects: {vestiaire: "+", relation: {josiane: 1}}
+      answer: "Là-haut, les ventilateurs soufflent. Vaubourg boit debout, entre deux armoires qui clignotent. « Merci. Elles ne m'en offrent jamais. »"
