+    right:
+      label: "Qu'as-tu dit d'autre ?"
+      effects: {direction: "-", set: [h8_ines_aveu], var: {h8_nuits: "+1"}}
+      answer: "« Les pires. Les chiffres, c'est l'écran. Le reste, quand il est vide, c'est moi. » Elle donne trois exemples. Tu les reconnais tous."
+
+  - id: ds.h8.op.phrases_lundi
+    roles: [ds]
+    arc: agents
+    tags: [agents, portable]
+    speaker: kara
+    lieu: domicile
+    tone: strategique
+    once: true
+    text: "Trois heures. Inès appelle de son poste, à voix basse : « “C’était lundi”, c'est moi. L'écran était vide, tu ne disais rien, il fallait quelqu'un. Je ne savais pas que c'était vrai. »"
+    left:
+      label: "Tu ne pouvais pas savoir"
+      effects: {vestiaire: "+", relation: {kara: 1}, set: [h8_ines_aveu], var: {h8_nuits: "+1"}}
+      answer: "« L'écran savait. Moi, j'ai juste dit l'heure. » Elle pleure sans bruit. On l'entend parce qu'elle ne tape plus."
+    right:
+      label: "Tu aurais pu te taire"
+      effects: {direction: "+", relation: {kara: -1}, set: [h8_ines_aveu], var: {h8_nuits: "+1"}}
+      answer: "« Oui. » Elle le dit tout de suite, sans défense. « La prochaine fois, je me tairai. Tu verras si c'est mieux. »"
+
+  - id: ds.h8.op.phrases
+    roles: [ds]
+    arc: agents
+    tags: [agents, portable]
