+# « L'Oreillette » (Histoire 8) — les cartes du script (arc `ds.h8.oreillette`,
+# content/arcs/ds/h8_script.yaml) : les ancres des trois saisons et de
+# l'épilogue, avec leurs variantes. Toutes hors du sac, toutes `once` sauf les
+# deux ancres rejouables de l'épilogue.
+#
+# La voix. Le jour, elle vouvoie (le modèle, avec la voix générée de Ferlac) ;
+# la nuit, elle tutoie (Inès Kara, qui lit l'écran et improvise quand il est
+# vide). Après la saisie, il n'y a plus d'oreillette : ce qui parle dans le noir
+# tutoie, et l'on ne sait plus qui.
+#
+# Les trois prédictions (et pas une de plus) : ds.h8.cp.un_demi (S0, chez
+# Ober), ds.h8.b2_cette_heure (S1, une heure du matin), ds.h8.c3_deux_heures
+# (S2, dans le noir : « Le petit, tu le signeras à cinquante-huit »).
+#
+# Compteurs : vars.h8_obei (on a fait ce que la voix disait), vars.h8_refus
+# (on a refusé), vars.h8_nuits (les nuits sans sommeil ; la laverie et la nuit
+# blanche les lisent).
+cards:
+  # ======================================================== SAISON 1 (S0)
+  # ----------------------------------------------------- 1 · Vollaire (slot 1)
+  # Le premier ordre. Les deux sorties ouvrent Kerdal (ds.h8.kerdal).
+  - id: ds.h8.a1_vollaire
+    roles: [ds]
+    arc: mercato
+    tags: [mercato, tribunes, oreillette]
+    lieu: bureau
+    tone: strategique
+    once: true
+    text: "Sur la grille de la Nord, une bâche de vingt mètres : VOLLAIRE, L'ENFANT DU QUAI. Dans ton oreille, le matin : « Vendez Vollaire. Valentienne paie quatre millions, à minuit moins deux. »"
+    left:
+      label: "Je vends Vollaire"
+      effects: {caisse: "++", tribunes: "--", set: [h8_vollaire_vendu], var: {h8_obei: "+1"}, schedule: [{card: ds.h8.kerdal.trois_fois, in: [1, 3]}], react: [{card: ds.h8.re.gege_bache}]}
+      answer: "Le contrat de Valentienne arrive à 23 h 58. À minuit, Gégé plie la bâche et la range dans son coffre, pas à la benne."
+    right:
+      label: "Je garde Vollaire"
+      effects: {tribunes: "+", caisse: "-", direction: "-", set: [h8_vollaire_garde], var: {h8_refus: "+1"}, schedule: [{card: ds.h8.kerdal.trois_fois, in: [1, 3]}]}
+      answer: "À minuit, la voix dit seulement l'heure. La bâche reste. Au matin, quelqu'un y a peint {nom}, plus petit, dans un coin."
+
+  # -------------------------------------------- 2 · Fin de cycle (slot 10)
+  # « Vendez Kerdal avant lundi. » Vingt-trois heures : c'est la voix de nuit,
+  # et elle n'ajoute rien. Les deux sorties mettent « lundi » en file : le
+  # seul moyen de le sauver est de l'avoir reposé ET de refuser.
+  - id: ds.h8.a2_fin_de_cycle_repos
+    roles: [ds]
+    arc: mercato
+    tags: [mercato, vestiaire, oreillette]
+    lieu: bureau
