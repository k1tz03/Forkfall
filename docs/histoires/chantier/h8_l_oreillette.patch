+    tags: [vestiaire]
+    speaker: kerdal
+    lieu: parking
+    tone: leger
+    once: true
+    text: "Samedi soir, Kerdal t'attend au parking, toujours en civil, la capuche baissée : « Tu m'as mis en tribune, {toi}. Je n'ai pas dormi quand même. Mais j'ai regardé le match. Ça faisait longtemps. »"
+    left:
+      label: "Tu dormiras"
+      effects: {vestiaire: "+", relation: {kerdal: 1}}
+      answer: "« C'est ce que dit Mbako. » Il remonte sa capuche. « Toi, tu ne dis jamais ce que dit ta machine. Je l'ai remarqué. »"
+    right:
+      label: "Tu rejoues mercredi"
+      effects: {direction: "+"}
