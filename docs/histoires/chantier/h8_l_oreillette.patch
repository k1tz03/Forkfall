+
+  # ------------------------------------------------- 2 · La vôtre
+  - id: ds.h8.co.la_votre
+    roles: [ds]
+    arc: corps
+    tags: [direction, objet]
+    speaker: ober
+    lieu: cabinet
+    tone: leger
+    once: true
+    text: "Ober pose ta courbe sur ton bureau : trois mois de nuits, deux heures en moyenne. « Le fonds la lit aussi. Il me demande si vous tiendrez jusqu'au mercato d'hiver. Je lui réponds quoi ? »"
+    left:
+      label: "Que je tiendrai"
+      effects: {direction: "+", vestiaire: "-"}
+      answer: "« Je l'écrirai. » Il range la feuille dans une chemise verte, avec d'autres, toutes à des noms du club. La tienne au-dessus."
+    right:
+      label: "Que je ne tiens pas"
+      effects: {direction: "--", vestiaire: "+", relation: {ober: 1}, set: [h8_ober_sait]}
+      answer: "Il te regarde longtemps. « Moi non plus. Ça fait deux. » Il déchire ta feuille en quatre, proprement, et garde les morceaux."
+
+  # -------------------------------------------------- 3 · Le docteur
+  - id: ds.h8.co.ober_kerdal
+    roles: [ds]
+    arc: corps
+    tags: [vestiaire, objet]
+    speaker: ober
+    lieu: cabinet
+    tone: strategique
+    once: true
+    text: "Ober te tend une courbe imprimée, datée du dimanche soir d'avant le lundi : Kerdal, cent dix au repos jusqu'à trois heures. « Je l'avais. Le fonds aussi. Personne ne m'a demandé de la lire. »"
+    left:
+      label: "Vous deviez la lire"
+      effects: {vestiaire: "+", relation: {ober: -1}, set: [h8_ober_coupable]}
