+# « L'Oreillette » (Histoire 8) — les manchettes. Schéma et règles : en-tête
+# de content/unes.yaml. Chacune lit une trace de l'histoire, fraîche de la
+# saison (`journal_has`, la ligne d'Almanach porte le drapeau en tag) : la Une
+# ne titre pas trois ans plus tard sur une chemise lavée trois fois.
+# Le Quotidien du Ballon (Léa), La Gazette Rose, L'Écho de la ville.
+unes:
+  # ------------------------------------------------------------- saison 1
+  - id: une.h8.kerdal
+    postulats: [le_modele]
+    roles: [ds]
+    journal: quotidien
+    priority: 3
+    when: "flag('h8_kerdal_mort') && journal_has('h8_kerdal_mort') && !flag('h8_kerdal_vendu')"
+    titre: "KERDAL, SOIXANTE-DIX MATCHS"
+    sous: "Le défenseur de {club} a été retrouvé un lundi soir entre deux bancs de la salle de muscu. Le club parle de fatigue. Le virage parle d'autre chose."
+    sujet: ds.h8.kerdal
+    photo: ds.h8.kerdal.lundi
+    react: [ { card: ds.h8.re.josiane_lundi, if: "!seen('ds.h8.re.josiane_lundi')" } ]
+  - id: une.h8.kerdal_portclair
+    postulats: [le_modele]
+    roles: [ds]
+    journal: gazette
+    priority: 3
+    when: "flag('h8_kerdal_mort') && journal_has('h8_kerdal_mort') && flag('h8_kerdal_vendu')"
+    titre: "KERDAL NE PARTIRA PAS À PORTCLAIR"
