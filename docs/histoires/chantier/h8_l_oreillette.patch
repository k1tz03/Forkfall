+    tags: [direction, objet]
+    speaker: aulard
+    lieu: secretariat
+    tone: leger
+    once: true
+    when: "flag('histoire_h8') && !flag('h8_vaubourg_mort')"
+    text: "Vaubourg s'arrête au clou du palier : « La photo de 1974, le fonds l'a emportée pour la numériser. Elle est partout, maintenant, paraît-il. Sauf ici. » Il touche le clou du bout de sa canne."
