+    right:
+      label: "Moi non plus"
+      effects: {direction: "-", relation: {ober: 1}}
+      answer: "Il hoche la tête. Vous restez de part et d'autre du bureau, sans rien dire, jusqu'à ce que la lumière du couloir s'éteigne."
+
+  - id: ds.h8.co.ober
+    roles: [ds]
+    arc: corps
+    tags: [direction, objet]
+    speaker: ober
+    lieu: cabinet
+    tone: strategique
+    once: true
+    text: "Ober ferme la porte du cabinet à clé, puis la fenêtre. « Almadis me paie pour les courbes de tout le monde. La vôtre comprise. Vous voulez que j'arrête de les envoyer ? Dites-le, et je le note. »"
+    left:
+      label: "Arrêtez tout"
+      effects: {vestiaire: "+", direction: "--", relation: {ober: 1}, set: [h8_ober_arrete]}
