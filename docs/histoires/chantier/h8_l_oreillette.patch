+
+  - id: ds.h8.re.josiane_lundi
+    roles: [ds]
+    arc: famille
+    tags: [direction]
+    speaker: josiane
+    lieu: secretariat
+    tone: leger
+    once: true
+    text: "Madame Josiane a laissé la lumière du secrétariat allumée toute la nuit. Au matin, elle pose une tasse devant toi : « Sa mère appelle à neuf heures. Je vous la passe, ou je lui passe le docteur ? »"
+    left:
+      label: "Passez-la-moi"
+      effects: {vestiaire: "+", relation: {josiane: 1}}
+      answer: "Neuf heures. Sa mère ne pose qu'une question : s'il dormait. Tu dis la vérité. Josiane a fermé la porte du secrétariat, de l'extérieur."
+    right:
+      label: "Le docteur"
+      effects: {direction: "+"}
