+    tags: [decor]
+    lieu: rue
+    tone: leger
+    cooldown: 40
+    when: "flag('histoire_h8') && season >= 3"
+    text: "{annee}. Le matin, tu longes le quai à pied jusqu'au club : les péniches, le pont, la Tréfilerie. Personne ne te dit l'heure d'arrivée. Tu arrives quand tu arrives."
+    left:
+      label: "Je prends le pont"
+      effects: {tribunes: "+"}
+      answer: "Sur le pont, un pêcheur te salue sans te reconnaître. Ou en te reconnaissant, et en s'en moquant. Tu préfères ne pas savoir."
+    right:
+      label: "Je longe l'eau"
+      effects: {vestiaire: "+"}
