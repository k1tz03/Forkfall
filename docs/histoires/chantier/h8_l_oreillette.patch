+    right:
+      label: "Laissez tourner"
+      effects: {direction: "+", set: [h8_laverie], var: {h8_nuits: "+1"}}
+      answer: "Il remet une pièce dans la fente, de sa poche. « Je ferme à une heure. » À une heure, tu es encore là ; lui aussi."
+
+  - id: ds.h8.sb.laverie
+    roles: [ds]
+    arc: corps
+    tags: [direction, sombre]
+    lieu: laverie
+    tone: strategique
+    once: true
+    text: "Minuit. Tu te réveilles sur la chaise en plastique de la laverie de la rue du Stade. Ta chemise tourne dans la 4. Le gérant : « C'est la troisième fois ce soir. Vous voulez que je l'arrête ? »"
+    left:
+      label: "Arrêtez-la"
