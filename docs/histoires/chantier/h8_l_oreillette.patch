+#   ober_montre     ← « Je garde mes courbes » (ds.h8.cp.un_demi*)
+#   aulard_chaise   ← la chaise de 1977 (ds.h8.vb.chaise)
+#   gege_bache      ← Vollaire vendu (ds.h8.a1_vollaire, à gauche)
+#   mbako_peyrard   ← le capitaine vendu à une heure quatre (ds.h8.b2_*)
+#   lea_dementi     ← le démenti de Télé-Stade (ds.h8.vd.dementi)
+#   kara_trois_heures ← le hall de l'hôtel de la Rive (ds.h8.op.hall*)
+#   gege_nino       ← IL HABITE ICI (ds.h8.vx.nino)
+#   gege_kambara    ← « Pars » (ds.h8.kb.appel)
+#   mbako_compo     ← la composition envoyée à Pari-Rive (ds.h8.pr.compo, à gauche)
+#   josiane_serveurs ← les machines montent (ds.h8.vb.bureau, à droite)
+#   mbako_refus     ← Kerdal pas vendu (ds.h8.a2_fin_de_cycle*, à droite)
+#   ober_quotidien  ← « Publiez tout » (ds.h8.co.quatre_ecus, à gauche)
+#   josiane_velo    ← « Je rends tout » (ds.h8.c2_propriete*, à gauche)
+#   gege_friche     ← l'oreillette prise sur la palette (ds.h8.sb.friche, à gauche)
+#   josiane_vaubourg ← la Une de la mort de Vaubourg (une.h8.vaubourg)
+cards:
+  - id: ds.h8.re.kerdal_tribune
+    roles: [ds]
