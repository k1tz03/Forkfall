+    tags: [direction, objet]
+    speaker: josiane
+    lieu: secretariat
+    tone: leger
+    once: true
+    when: "flag('histoire_h8') && flag('h8_voiture_rendue')"
+    text: "Madame Josiane a ressorti du placard le vieux fax du club et l'a rebranché. « Puisqu'ils vous ont tout repris. Celui-là est à moi. Et il signe tout ce qu'il envoie. »"
+    left:
+      label: "J'envoie une offre"
+      effects: {caisse: "+", relation: {josiane: 1}}
+      answer: "La machine crache un accusé de réception, ton nom imprimé en haut de la page. Josiane le range dans un classeur neuf, à la première page."
+    right:
+      label: "Je n'ai rien à envoyer"
+      effects: {vestiaire: "+"}
+      answer: "« Alors il attendra. » Elle pose une housse sur le fax, comme sur une cage d'oiseau, et éteint en partant."
+
+  - id: ds.h8.rt.centre_mercredi
+    roles: [ds]
+    arc: formation
+    tags: [vestiaire, formation]
+    lieu: terrain
+    tone: leger
+    cooldown: 40
+    when: "flag('histoire_h8') && season >= 3"
+    text: "{annee}. Le mercredi, au centre de formation, des gamins de quatorze ans courent derrière un ballon trop gonflé. Tu n'as plus d'écran. Tu regardes qui court quand le ballon est loin."
+    left:
+      label: "J'écris un nom"
+      effects: {vestiaire: "+"}
+      answer: "Un seul nom, au crayon, sur le dos de ta main. Le soir, tu le recopies sur papier avant qu'il s'efface. Tu ne le dis à personne."
+    right:
+      label: "Je n'écris rien"
+      effects: {tribunes: "+", direction: "-"}
+      answer: "Tu les regardes jusqu'à la nuit. Le dernier à partir range les plots sans qu'on le lui demande. Tu retiens son pas, pas son nom."
+
+  - id: ds.h8.rt.buvette_vendredi
