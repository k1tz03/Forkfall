+  - id: ds.h8.pro6_pont_roulant
+    roles: [ds]
+    arc: corps
+    tags: [direction, decor]
+    lieu: domicile
+    tone: strategique
+    once: true
+    text: "Deux heures dix, le duplex de la Tréfilerie que le fonds te loue. Au-dessus du lit, le pont roulant de l'usine. L'oreillette est sur la table de nuit. Tu l'entends quand même : « Tu ne dors pas. »"
+    left:
+      label: "Je la remets"
+      effects: {direction: "+", vestiaire: "-", var: {cadeau_duplex_trefilerie: "+1", h8_nuits: "+1"}}
