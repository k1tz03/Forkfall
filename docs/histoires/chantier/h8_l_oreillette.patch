+    tone: leger
+    once: true
+    text: "Gégé a les doigts dans le grillage des moins de dix-sept ans : « Le petit de Nino. Milo. Seize ans. » Au cou du gamin, le sifflet de Mbako. « Ta machine l'a vu aussi, {toi} ? »"
+    left:
+      label: "Je regarde sa courbe"
+      effects: {direction: "+", tribunes: "-", var: {h8_obei: "+1"}}
+      answer: "Rouge depuis ses quatorze ans. Une règle simple : trop de matchs trop tôt, fin de cycle. Elle date de 2017. Tu te rappelles la date."
+    right:
+      label: "Je le regarde courir"
+      effects: {vestiaire: "+", relation: {gege: 1}, var: {h8_refus: "+1"}}
