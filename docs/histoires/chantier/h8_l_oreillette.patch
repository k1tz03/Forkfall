+          - { arc: ds.h8.pari_rive, poids: 1.0 }
+          - { arc: ds.h8.classeur,  poids: 0.9 }
+          - { arc: ds.h8.fonds,     poids: 0.7 }
+      # Saison 2 : le bruit. Pas de reprise : les intrigues de la première
+      # saison ont eu leur chance, et leur seconde chance passe par le
+      # maintien des arcs (jamais après le créneau 11, ni dans la saison de
+      # l'acte final : leur `when`). Mbako peut partir pour le Kambara dès le
+      # printemps 2026 ; la saison 3 n'en sera que plus silencieuse.
+      "1":
+        prendre: 3
+        fenetre: [2, 11]
+        reserve: 0
+        reprise: false
+        pool:
+          - { arc: ds.h8.video,      poids: 1.0 }
+          - { arc: ds.h8.vieux,      poids: 1.0 }
