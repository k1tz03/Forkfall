+          - { arc: ds.h8.operatrice, poids: 1.2 }
+          - { arc: ds.h8.greve,      poids: 1.4 }
+          - { arc: ds.h8.kambara,    poids: 1.0 }
+          - { arc: ds.h8.classeur,   poids: 0.8 }
+          - { arc: ds.h8.fonds,      poids: 0.7 }
