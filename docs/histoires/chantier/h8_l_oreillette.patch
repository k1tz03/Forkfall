+          - { arc: ds.h8.ober,    poids: 3.0 }
+          - { arc: ds.h8.suivant, poids: 2.0 }
+    objectifs:
+      - { id: modele_kerdal_vit, titre: "Kerdal a dormi",          when: "flag('h8_kerdal_vit')", indice: "Une courbe rouge n'est pas une date." }
+      - { id: modele_sans_voix,  titre: "Une saison sans la voix", when: "flag('h8_rentree_sans') && flag('h8_sans_oreillette')", indice: "On peut entendre un vestiaire sans machine." }
+      - { id: modele_mbako,      titre: "Le car de six heures",    when: "flag('h8_mbako_embrasse')", indice: "Il préfère qu'on le regarde courir." }
+    alarm_overrides:                  # passent devant les alarmes communes du directeur sportif
+      vestiaire.low:
+        - { card: ds.h8.alarme.vestiaire_bas_mbako, when: "!flag('h8_mbako_parti') && !flag('h8_mbako_embrasse')" }
+        - { card: ds.h8.alarme.vestiaire_bas_staff }
+      vestiaire.high:
+        - { card: ds.h8.alarme.vestiaire_haut }
+      tribunes.low:
+        - { card: ds.h8.alarme.tribunes_bas }
+      tribunes.high:
+        - { card: ds.h8.alarme.tribunes_haut }
+      direction.low:
+        - { card: ds.h8.alarme.direction_bas }
+      direction.high:
+        - { card: ds.h8.alarme.direction_haut }
+      caisse.low:
+        - { card: ds.h8.alarme.caisse_bas_voix, when: "!flag('h8_sans_oreillette') && !flag('h8_voiture_rendue')" }
+        - { card: ds.h8.alarme.caisse_bas }
+      caisse.high:
+        - { card: ds.h8.alarme.caisse_haut }
 
