+    right:
+      label: "Et toi, ça va ?"
+      effects: {relation: {vandel: 1}}
+      answer: "« Moi, je joue. » Il hausse les épaules. « Au Kambara, ils ont gardé le brassard sur leur maillot. Une bande noire, cousue. »"
+
+  - id: sl.h9.rt.josiane_neige
+    roles: [selectionneur]
+    arc: direction
+    tags: [direction, decor]
+    speaker: josiane
+    tone: leger
+    once: true
+    when: "flag('histoire_h9') && season >= 2"
+    text: "Il neige sur le club-house. Madame Josiane, {age_josiane} ans, balaie les marches elle-même, en manteau : « En 1990, on jouait sous la neige. Personne n'appelait ça un exploit. »"
+    left:
+      label: "Je prends le balai"
+      effects: {tribunes: "+", relation: {josiane: 1}}
+      answer: "Elle te le cède sans discuter. Elle te regarde balayer, les mains dans les poches, et corrige ta technique à voix basse."
+    right:
+      label: "Rentrez, Josiane"
+      effects: {tribunes: "-", direction: "+"}
+      answer: "« Je rentrerai quand ce sera propre. » Elle finit la dernière marche, puis rentre, et ferme la porte sur la neige."
+
+  # ═══════════════════════════════════════ CE QUI REVIENT (les traces relues)
