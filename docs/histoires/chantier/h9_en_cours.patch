+    right:
+      label: "Je tire le rideau"
+      effects: {direction: "+"}
+      answer: "Le rideau est double, épais, prévu pour ça. Dans le noir climatisé, tu pourrais être n'importe où. C'est le but."
+
+  - id: sl.h9.rt.ad_souk
+    roles: [selectionneur]
+    arc: moment
+    tags: [al_dorado, decor]
+    lieu: ailleurs
+    tone: leger
+    once: true
+    when: "flag('histoire_h9') && season == 1 && flag('h9_depart')"
+    text: "Le marché couvert d'Al-Dorado, climatisé jusqu'au plafond. Un marchand vend des écharpes de laine aux supporters venus du Nord, à prix d'or. Il porte un pull, lui aussi."
