+    tone: leger
+    once: true
+    when: "flag('histoire_h9') && season <= 1 && !(season == 1 && flag('h9_depart'))"
+    text: "Au cimetière, Madame Aubert, {age_aubert} ans, dépose une gerbe sur la tombe de Kévin Marçais, en gants noirs, sans photographe. Elle se redresse lentement et te voit."
