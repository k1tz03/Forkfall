+    tags: [al_dorado, telephone]
+    lieu: ailleurs
+    tone: leger
+    once: true
+    when: "flag('histoire_h9') && season <= 1"
+    text: "Al-Dorado, l'hôtel des délégations. Le téléphone de la chambre sonne à minuit : Lian Mbako, du Kambara, trois étages plus bas. « On le porte demain. Les Cobalts le porteront ? »"
+    left:
+      label: "Oui"
+      effects: {tribunes: "+", direction: "-", set: [h9_mbako_oui], outcome: oui}
+      answer: "« Alors on se croisera au troisième match. » Il raccroche. Trois étages plus bas, une fenêtre s'éteint."
+    right:
+      label: "Je ne sais pas"
+      effects: {tribunes: "-", direction: "+", set: [h9_mbako_doute], outcome: doute}
+      answer: "« Moi non plus, il y a un mois. » Un silence. « On a trois matchs pour savoir. Dormez, si vous y arrivez. »"
+
