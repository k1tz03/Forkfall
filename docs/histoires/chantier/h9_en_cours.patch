+      h9_listes_gardees: "{annee} : à la demande de {nom}, Le Quotidien garde les listes de Sacha pour après le Mondial."
+      h9_local_force: "{annee} : le local de l'association de Sacha, au-dessus du kiosque du quai, a été forcé."
+    hint: "Une fille qui recompte chaque semaine, et un journal qui attend une phrase."
+    same_club: true
+    fallback: drop
+    steps:
+      - id: recompte
+        card: sl.h9.listes.recompte
+        next: [ { step: quotidien, in: [2, 4] } ]
+      - id: quotidien
+        card:
+          - { id: sl.h9.listes.quotidien_loin, if: "season == 1 && flag('h9_depart')" }
+          - { id: sl.h9.listes.quotidien }
+        next:
+          - { step: local, if: "season == 0", at_season: 1, at: [3, 10] }
+          - { step: local, in: [2, 5] }
+      - id: local
+        card:
+          - { id: sl.h9.listes.local_loin, if: "season == 1 && flag('h9_depart')" }
+          - { id: sl.h9.listes.local }
+        next: []
+
+  - id: sl.h9.fraicheur
+    title: "Un peu de leur fraîcheur"
+    kind: serie
+    roles: [selectionneur]
+    postulats: [mondial_hiver]
+    foreground: true
+    weight: 0.9
+    once: true
+    theme: formation
+    carrier: vecchio
+    cast: [vecchio, gege, vandel]
+    when: "flag('histoire_h9') && season <= 1 && chars.vecchio.statut != 'mort'"
+    issues: [promis, oublie]
+    traces:
+      h9_gants_gigi: "{annee} : le troisième gardien des Cobalts plonge avec les gants jaunes de Gigi Vecchio."
+      h9_fraicheur_promise: "{annee} : {nom} a promis à Gigi Vecchio de lui rapporter un peu de la fraîcheur du Dôme."
+      h9_fraicheur_rapportee: "{annee} : Gigi Vecchio a tenu à deux mains une bouteille d'eau du Dôme. Il ne l'a pas bue."
+    hint: "Un vieux gardien qui a pris la pluie quarante ans veut savoir ce que vaut un toit."
+    same_club: true
+    fallback: drop
+    steps:
+      - id: gants
+        card: sl.h9.fraicheur.gants
+        next: [ { step: aube, in: [2, 4] } ]
+      - id: aube
+        card:
+          - { id: sl.h9.fraicheur.aube_loin, if: "season == 1 && flag('h9_depart')" }
+          - { id: sl.h9.fraicheur.aube }
+        next: [ { step: promesse, in: [2, 4] } ]
+      - id: promesse
+        card:
+          - { id: sl.h9.fraicheur.promesse_loin, if: "season == 1 && flag('h9_depart')" }
+          - { id: sl.h9.fraicheur.promesse }
+        next:
+          - { step: retour, if: "season == 0", at_season: 2, at: [2, 7] }
+          - { step: retour, if: "season == 1", at_season: 1, at: [2, 7] }
+      - id: retour
+        card:
+          - { id: sl.h9.fraicheur.retour_bouteille, if: "flag('h9_fraicheur_promise')" }
+          - { id: sl.h9.fraicheur.retour }
+        next: []
+
+  # ══════════════════════════════════════════════════════════════ 2030 (S1)
+  - id: sl.h9.deux_listes
+    title: "Les deux listes"
+    kind: serie
+    roles: [selectionneur]
+    postulats: [mondial_hiver]
+    foreground: true
+    weight: 1.5
+    once: true
+    min_season: 1
+    theme: selection
+    carrier: sauvan
+    cast: [sauvan, vandel, brehaut]
+    when: "flag('histoire_h9')"
