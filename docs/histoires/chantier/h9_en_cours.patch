+      h9_liste_ministere: "{annee} : sur la liste des vingt-six, Noa Vandel est barré au crayon. « Fatigué. »"
+      h9_syndicat_brassard: "{annee} : le syndicat des joueurs soutient le brassard. Le ministre a demandé son âge à Karim Fauvel."
+    hint: "Deux listes de vingt-six noms, identiques à un trait de crayon près."
+    same_club: true
+    fallback: drop
+    steps:
+      - id: listes
+        this_season: true
+        on_expire: skip
+        card: sl.h9.deux_listes.listes
+        next: [ { step: suite, in: [3, 4] } ]
+      - id: suite
+        this_season: true
+        on_expire: skip
+        card:
+          - { id: sl.h9.deux_listes.noa, if: "flag('h9_liste_ministere')" }
+          - { id: sl.h9.deux_listes.syndicat }
+        next: [ { step: medecin, in: [2, 4] } ]
+      # Les capteurs des protège-tibias (la Nouvelle de 2029) contre le mot du
