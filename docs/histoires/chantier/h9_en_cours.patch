+    tone: leger
+    once: true
+    when: "flag('histoire_h9') && flag('h9_four_secret') && !(season == 1 && flag('h9_depart'))"
+    text: "Cinq heures. Le fournil est éclairé ; Marie-Jo te voit passer et t'ouvre la porte de service, la baguette du bout à la main. Depuis qu'elle t'a parlé du four, elle ne dit plus rien. Elle donne."
+    left:
+      label: "Je la prends"
