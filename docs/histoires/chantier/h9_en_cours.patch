+    tone: leger
+    once: true
+    when: "flag('histoire_h9') && !(season == 1 && flag('h9_depart'))"
+    text: "La croix verte de la pharmacie affiche l'heure, puis la température : 4 °C. Tu restes sur le trottoir à attendre que le chiffre change. Il ne change pas."
+    left:
+      label: "J'attends encore"
+      effects: {vestiaire: "-"}
+      answer: "Cinq degrés, enfin. Tu repars. Pendant tout le reste de la journée, tu ne retrouves plus le mot « fret »."
