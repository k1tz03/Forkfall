+      label: "Je la coupe"
+      effects: {tribunes: "+", relation: {mariejo: 1}, set: [h9_four_paye]}
+      answer: "Le couteau crisse sur la croûte. Elle distribue les morceaux aux clients de la file, un par un. Personne ne paie, ce matin-là."
+    right:
+      label: "Coupez-la, vous"
+      effects: {vestiaire: "+", set: [h9_four_paye]}
+      answer: "Elle la coupe d'un geste, sans hésiter, comme on coupe un ruban. Elle te tend le croûton du bout. Il est brûlé d'un côté."
+
+  # ══════════════════════════════════════════════════════ LE CARTON DE 2010
+  - id: sl.h9.carton.legs
+    roles: [selectionneur]
+    arc: direction
+    tags: [direction, objet]
+    lieu: domicile
+    tone: strategique
+    once: true
+    text: "Madame Josiane est morte un mardi, en dormant, à {age_josiane} ans. Le notaire te remet un carton à ton nom, fermé au scotch, marqué « 2010 ». Il pèse plus lourd que dans la cave."
+    left:
+      label: "Je l'ouvre"
+      effects: {direction: "-", set: [h9_carton_josiane], char: {josiane: mort}}
+      answer: "Dessus, l'original du procès-verbal, plié dans un mouchoir. Dessous, quarante ans de fiches de licence, par année. Pas une ne manque."
+    right:
+      label: "Je le range"
+      effects: {vestiaire: "-", set: [h9_carton_josiane], char: {josiane: mort}}
