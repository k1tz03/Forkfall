+++ b/content/cards/selectionneur/h9_decor.yaml
@@ -0,0 +1,570 @@
+# Histoire 9 — « Vingt degrés dedans » : le sac (cartes de routine du
+# sélectionneur, tirées entre les temps d'histoire). Chacune lit
+# `flag('histoire_h9')` : elles n'existent que dans ce livre. Une carte
+# d'Aubérive ne sort pas pendant le Mondial (`season == 1 && flag('h9_depart')`) ;
+# trois cartes d'Al-Dorado prennent la relève, dans la chambre à dix-huit
+# degrés. Les cartes Liste (la feuille des vingt-six) sont ici aussi.
+cards:
+  # ═══════════════════════════════════════════════════ LA RUE DES LILAS
+  - id: sl.h9.rt.boite_fer
+    roles: [selectionneur]
+    arc: famille
+    tags: [famille, decor]
+    speaker: mariejo
+    tone: leger
+    once: true
+    when: "flag('histoire_h9') && season == 0"
+    text: "Marie-Jo compte ta monnaie deux fois, et se trompe deux fois. À côté de la caisse, une boîte en fer, un mot au feutre : « Pour Kévin. » Elle ne dit pas pour quoi faire."
+    left:
+      label: "Je mets une pièce"
+      effects: {tribunes: "+", relation: {mariejo: 1}}
+      answer: "La pièce tombe sur d'autres pièces. La boîte est presque pleine. Marie-Jo ne regarde pas ; elle a appris à ne pas regarder."
+    right:
+      label: "Je ne demande pas"
+      effects: {vestiaire: "+"}
+      answer: "Tu prends ta baguette. Derrière toi, un vieux monsieur glisse un billet dans la boîte, plié en huit, et s'en va sans pain."
+
+  - id: sl.h9.rt.photo_porte
+    roles: [selectionneur]
+    arc: famille
+    tags: [famille, decor]
+    speaker: mariejo
+    tone: leger
+    once: true
+    when: "flag('histoire_h9') && season == 1 && !flag('h9_depart')"
+    text: "Marie-Jo a déplacé la photo de Kévin : elle n'est plus au-dessus de la caisse, mais face à la porte d'entrée. « Il était curieux. Il veut voir qui entre, {toi}. »"
+    left:
+      label: "Il me voit entrer"
+      effects: {tribunes: "+"}
+      answer: "« Tous les matins. » Elle te tend ta baguette, emballée dans une page du Quotidien où l'on parle du Dôme. Tu ne la déplies pas."
+    right:
+      label: "Et il voit qui sort ?"
+      effects: {relation: {mariejo: 1}}
+      answer: "Elle réfléchit, sérieusement. « Ceux-là, je les regarde moi-même. » Elle te rend la monnaie, et te regarde sortir."
+
+  - id: sl.h9.rt.brehaut_escalier
+    roles: [selectionneur]
+    arc: direction
+    tags: [direction, decor]
+    speaker: brehaut
+    lieu: bureau
+    tone: leger
+    once: true
+    when: "flag('histoire_h9') && season == 0"
+    text: "Bréhaut monte l'escalier de la Fédération une marche à la fois, la main sur le genou. Il refuse l'ascenseur : « En panne depuis 2010. On me l'a dit en 2010. »"
+    left:
+      label: "Je monte avec vous"
+      effects: {direction: "+", relation: {brehaut: 1}}
+      answer: "Trois étages, une marche à la fois. Au deuxième, il s'arrête et souffle : « Douze ans de brassard. Le genou s'en souvient. »"
+    right:
+      label: "Je prends l'ascenseur"
+      effects: {vestiaire: "+"}
+      answer: "Il marche très bien, l'ascenseur. En haut, Bréhaut arrive essoufflé, et ne te demande pas comment tu es monté{pg, select, f{e} other{}}."
+
+  - id: sl.h9.rt.sacha_gamelle
+    roles: [selectionneur]
+    arc: famille
+    tags: [famille, decor]
+    speaker: sacha
+    lieu: domicile
+    tone: leger
+    once: true
+    when: "flag('histoire_h9') && season == 0"
+    text: "Sacha a gardé les clés de ton appartement depuis le lycée. Elle est passée sans prévenir et t'a laissé sur la table une gamelle encore tiède, et un mot : « Mange. Après, tu compteras. »"
+    left:
+      label: "Je mange"
+      effects: {vestiaire: "+", relation: {sacha: 1}}
+      answer: "Des lentilles, comme quand elle avait dix ans et que c'était toi qui cuisinais. Tu laves la gamelle et la poses près de la porte."
+    right:
+      label: "Je mange au club"
+      effects: {direction: "+"}
+      answer: "Le plat du jour du club-house, trois fois par semaine. Chez toi, la gamelle attend sur la table, couvercle fermé, comme un reproche."
+
+  - id: sl.h9.rt.sacha_canape
+    roles: [selectionneur]
+    arc: famille
+    tags: [famille, decor]
+    speaker: sacha
+    lieu: domicile
+    tone: leger
+    once: true
+    when: "flag('histoire_h9') && !(season == 1 && flag('h9_depart')) && season <= 1"
+    text: "Sacha s'est endormie sur ton canapé, l'ordinateur ouvert sur les genoux. À l'écran, une colonne de noms descend toute seule. Elle a mis une alarme : « recompter, lundi »."
+    left:
+      label: "Je ferme l'ordinateur"
+      effects: {vestiaire: "+"}
+      answer: "Le ventilateur s'arrête. Dans le silence, Sacha dit un nom en dormant, un prénom étranger. Tu ne le connais pas. Elle, si."
+    right:
+      label: "Je lis la colonne"
+      effects: {relation: {sacha: 1}, vestiaire: "-"}
+      answer: "Tu lis jusqu'au matin. Quand elle se réveille, tu es à la ligne trois cent six. Elle ne dit rien ; elle fait du café pour deux."
+
+  - id: sl.h9.rt.sacha_mur
+    roles: [selectionneur]
+    arc: famille
+    tags: [famille, decor]
+    speaker: sacha
+    lieu: domicile
+    tone: leger
+    once: true
+    when: "flag('histoire_h9') && season == 1 && !flag('h9_depart')"
+    text: "Sacha a punaisé au mur de ta cuisine une carte d'Al-Dorado, et dessus, au feutre rouge, une croix par chantier. Le Dôme a la plus grosse. « Tu sauras où tu es, {toi}. »"
+    left:
+      label: "Laisse-la au mur"
+      effects: {relation: {sacha: 1}, direction: "-"}
+      answer: "Elle reste au mur. Le soir, tu manges face aux croix. Tu finis par savoir les compter sans les regarder."
+    right:
+      label: "Pas dans ma cuisine"
+      effects: {direction: "+", relation: {sacha: -1}}
+      answer: "Elle la décroche, la roule, et la glisse dans ta valise, déjà ouverte sur le lit. « Alors tu l'emporteras. »"
+
+  # ════════════════════════════════════════════════ LE MINISTÈRE, LA LIGUE
+  - id: sl.h9.rt.sauvan_cafe
+    roles: [selectionneur]
+    arc: direction
+    tags: [direction, decor]
+    speaker: sauvan
+    lieu: cafe
+    tone: leger
+    once: true
+    when: "flag('histoire_h9') && !(season == 1 && flag('h9_depart')) && season <= 1"
+    text: "Café de la Mairie. Sauvan t'attend à la même table, deux cafés déjà servis. Il a apporté des biscuits de la Capitale dans une boîte en carton : « Pour la Fédération. Et pour vous, {toi}. »"
+    left:
