+    right:
+      label: "Au capitaine"
+      effects: {vestiaire: "+"}
+      answer: "« Le capitaine de quoi ? » Marie-Jo sourit, pour la première fois de la matinée. « De tout le monde. »"
+
+  - id: sl.h9.rt.cave_frais
+    roles: [selectionneur]
