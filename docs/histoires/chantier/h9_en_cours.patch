+    lieu: domicile
+    tone: leger
+    once: true
+    when: "flag('histoire_h9') && flag('h9_apres_garde')"
+    text: "Le tiroir du buffet ne ferme plus bien. Dedans, le brassard noir de Noa, plié en quatre, sur des factures. Tu cherchais des piles pour la télécommande."
+    left:
+      label: "Je referme"
