+          - { id: sl.h9.c2_bureau_porte,   if: "flag('h9_brassard_porte')" }
+          - { id: sl.h9.c2_bureau_aubert,  if: "flag('h9_aubert_vue')" }
+          - { id: sl.h9.c2_bureau }
+        at: [8, 9]
+        season: 2
+      # L'intermède de 2031 : le stade plein de casques, la nuit d'avant.
+      - id: casques
+        card: sl.h9.c35_casques
+        at: [13, 13]
+        season: 2
+      - id: minute
+        card:
+          - { id: sl.h9.c3_minute_dos,           if: "flag('h9_trophee')" }
+          - { id: sl.h9.c3_minute_verite_manche, if: "flag('h9_brassard_porte') && flag('h9_page_lea') && flag('h9_seconde_manche')" }
+          - { id: sl.h9.c3_minute_verite,        if: "flag('h9_brassard_porte') && flag('h9_page_lea')" }
+          - { id: sl.h9.c3_minute_geste_manche,  if: "flag('h9_brassard_porte') && flag('h9_seconde_manche')" }
+          - { id: sl.h9.c3_minute_geste,         if: "flag('h9_brassard_porte')" }
+          - { id: sl.h9.c3_minute_prix_manche,   if: "flag('h9_seconde_manche')" }
+          - { id: sl.h9.c3_minute }
+        at: [15, 16]
+        season: 2
+      - id: decembre
+        card:
+          - { id: sl.h9.c4_decembre_four, if: "flag('h9_four_caution') || flag('vl_h9_four')" }
+          - { id: sl.h9.c4_decembre }
+        at: [17, 17]
+        season: 2
+      # -------------------------------------------- 2032 et après (S3+)
+      - id: janvier
+        card:
+          - { id: sl.h9.d1_janvier_encore, if: "season >= 4" }
+          - { id: sl.h9.d1_janvier }
+        at: [1, 1]
+        season: "3+"
+      # 2032 : la première sélection du petit gardien, avec ou sans les gants
+      # jaunes de Gigi (donnés en 2029, ou rendus par Gégé en 2031).
+      - id: gardien
+        card:
+          - { id: sl.h9.d15_gants, if: "flag('h9_gants_gigi') || seen('sl.h9.pluie.sac')" }
+          - { id: sl.h9.d15_gardien }
+        at: [9, 10]
+        season: "3"
+      # Le Dôme à la télévision (2032), puis vendu pour faire de la neige
+      # (2033) : c'est la dernière carte du livre, elle mène à « Le tiroir ».
+      - id: dome
+        card:
+          - { id: sl.h9.d2_dome_encore, if: "season >= 4" }
+          - { id: sl.h9.d2_dome }
+        at: [17, 17]
+        season: "3+"
