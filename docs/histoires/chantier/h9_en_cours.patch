+
+  # ═══════════════════════════════════════════ AL-DORADO (la chambre à 18 °C)
+  - id: sl.h9.rt.ad_chambre
+    roles: [selectionneur]
+    arc: moment
+    tags: [al_dorado, decor]
+    lieu: ailleurs
+    tone: leger
+    once: true
+    when: "flag('histoire_h9') && season == 1 && flag('h9_depart')"
+    text: "Chambre 1407 de l'hôtel des délégations. Le thermostat est bloqué à dix-huit. La fenêtre ne s'ouvre pas. Tu poses la main sur la vitre : de l'autre côté, elle est brûlante."
+    left:
+      label: "Je garde la main"
