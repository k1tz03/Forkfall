+    roles: [selectionneur]
+    arc: vestiaire
+    tags: [vestiaire, decor]
+    tone: leger
+    once: true
+    when: "flag('histoire_h9') && season == 0"
+    text: "La liste de mars. Vingt-six noms sur une feuille, à la machine. En bas, effacé à la gomme, on lit encore un vingt-septième nom : celui d'un électricien de vingt-quatre ans."
+    left:
