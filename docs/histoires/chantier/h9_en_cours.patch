+    roles: [selectionneur]
+    arc: vestiaire
+    tags: [vestiaire, al_dorado]
+    lieu: ailleurs
+    tone: strategique
+    once: true
+    when: "flag('histoire_h9') && season <= 1"
+    text: "Al-Dorado, l'infirmerie de l'hôtel. Le médecin de la Fédération te tend un certificat déjà signé : « État de fatigue. » Pour le capitaine, la veille du match. Il ne manque que ta signature."
+    left:
+      label: "Je le déchire"
+      effects: {vestiaire: "+", direction: "--"}
+      answer: "Les morceaux tombent dans la corbeille de l'infirmerie, à côté des pansements. Le médecin te regarde faire comme on regarde un orage."
+    right:
+      label: "Je le range"
+      effects: {direction: "+", vestiaire: "-"}
+      answer: "Tu le plies dans ta poche de veste, avec le reste. Il ne sert pas. Il pèse."
+
