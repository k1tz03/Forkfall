+    tone: leger
+    once: true
+    when: "flag('histoire_h9') && season >= 1 && !(season == 1 && flag('h9_depart'))"
+    text: "La liste de septembre. Madame Josiane la tape, puis s'arrête : « Le ministère demande à la recevoir “pour information”, une heure avant les journaux. Je l'envoie, {toi} ? »"
