+    tone: leger
+    once: true
+    when: "flag('histoire_h9') && season >= 3 && seen('sl.h9.apres.depart_sacha')"
+    text: "Une carte postale de Sacha, d'un pays où il fait froid : une photo de chantier sous la neige. Au dos, un seul chiffre, et en dessous : « Zéro, ici. Je recompte quand même, {toi}. »"
+    left:
+      label: "Je la punaise"
+      effects: {relation: {sacha: 1}}
+      answer: "Tu la punaises sur le frigo, à hauteur d'yeux. Le zéro tient toute la carte. Il est écrit gros, exprès."
+    right:
+      label: "Je lui réponds"
+      effects: {vestiaire: "+", relation: {sacha: 1}}
