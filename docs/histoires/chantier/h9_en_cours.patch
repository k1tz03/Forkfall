+    right:
+      label: "On gagnera quoi, nous ?"
+      effects: {direction: "+"}
+      answer: "« Vous ? » Il regarde la photo, puis toi. « Le droit de dormir, si vous faites attention. C'est déjà beaucoup. »"
+
+  # ════════════════════════════════════════════════════ LE VESTIAIRE
+  - id: sl.h9.rt.footing
+    roles: [selectionneur]
