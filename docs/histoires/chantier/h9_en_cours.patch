+    right:
+      label: "Je laisse la trace"
+      effects: {tribunes: "+"}
+      answer: "La liste part comme ça, avec son fantôme. Personne ne le remarque, sauf un journaliste de L'Écho, qui ne l'écrit pas."
+
+  - id: sl.h9.rt.liste_septembre
+    roles: [selectionneur]
