+    right:
+      label: "Envoyez-la avant"
+      effects: {tribunes: "-", direction: "+"}
+      answer: "Elle l'envoie au ministère. Une heure plus tard, elle revient sans une rature. Josiane la regarde longtemps, sans y croire."
+
+  - id: sl.h9.rt.troisieme_gardien
