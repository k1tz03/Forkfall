+
+  - id: sl.h9.rt.maquette
+    roles: [selectionneur]
+    arc: sponsors
+    tags: [sponsors, decor]
+    lieu: rue
+    tone: leger
+    once: true
+    when: "flag('histoire_h9') && season == 1 && !flag('h9_depart')"
+    text: "Dans la vitrine de l'agence Tessandier, une maquette du Dôme offerte par l'ambassade d'Al-Dorado, sous une cloche de verre. Un enfant souffle sur la vitre pour y faire de la buée."
+    left:
+      label: "Je regarde la maquette"
+      effects: {tribunes: "-", direction: "+"}
+      answer: "Sur le toit, des figurines minuscules, en casque, posées au bord. Quelqu'un, à l'atelier, a trouvé utile de les mettre."
+    right:
+      label: "Je regarde l'enfant"
+      effects: {tribunes: "+"}
