+    right:
+      label: "Jette le ticket"
+      effects: {vestiaire: "+"}
+      answer: "Elle jette le ticket, garde la licence, et enroule le fil noir autour de son propre poignet, sans demander."
+
+  - id: sl.h9.rt.vandel_lettre
+    roles: [selectionneur]
+    arc: vestiaire
+    tags: [vestiaire, decor]
+    speaker: vandel
+    tone: leger
+    once: true
+    when: "flag('histoire_h9') && season >= 2"
+    text: "Noa passe au stade de la Rive, en civil, un sac de courses à la main. Son frère est rentré du Dôme ; il travaille sur un toit d'Aubérive, à huit mètres. « Ça lui paraît bas, {toi}. »"
+    left:
+      label: "Dis-lui bonjour"
+      effects: {vestiaire: "+", relation: {vandel: 1}}
