+# puis Le carton de 2010, qui attend que le four soit payé — et le décor des
+# années qui suivent. La carrière n'arrive ici que si le brassard est entré au
+# Dôme sans que la page de 2010 parte, et que tu es resté immobile à la
+# minute : ce qui reste, c'est ce qu'on a gardé.
+cards:
+  # ═══════════════════════════════════════════════════════════════ APRÈS
+  - id: sl.h9.apres.raccroche
+    roles: [selectionneur]
+    arc: vestiaire
+    tags: [vestiaire, objet]
+    speaker: vandel
+    lieu: vestiaire
+    tone: leger
+    once: true
+    text: "Noa Vandel raccroche, un genou de trop. Dans le vestiaire vide, il te tend le brassard noir, lavé, repassé, plié en quatre : « Il est à vous, maintenant. Ou à personne, {toi}. »"
+    left:
+      label: "Je le garde"
+      effects: {vestiaire: "+", relation: {vandel: 1}, set: [h9_apres_garde], outcome: garde}
+      answer: "Tu le ranges dans le tiroir du buffet, avec ce que tu n'as pas jeté. Noa ferme son casier une dernière fois, sans le cadenas."
+    right:
+      label: "Rends-le à Marie-Jo"
+      effects: {tribunes: "+", set: [h9_apres_rendu], outcome: rendu}
+      answer: "Il le porte lui-même rue des Lilas, en survêtement. Marie-Jo le punaise sous la photo de Kévin, bien droit, pour une fois."
+
+  - id: sl.h9.apres.depart_sacha
+    roles: [selectionneur]
+    arc: famille
+    tags: [famille]
+    speaker: sacha
+    lieu: domicile
+    tone: leger
+    once: true
+    text: "Sacha part travailler loin, pour une union de syndicats du bâtiment. Elle te laisse ses listes, toutes, dans trois cartons scotchés : « Tu sauras où les mettre, {toi}. »"
+    left:
+      label: "Chez Josiane, à la cave"
+      effects: {direction: "-", relation: {sacha: 1}, set: [h9_listes_josiane]}
+      answer: "Josiane les fait ranger entre 2010 et 2011, sans les ouvrir. « Elles seront bien là. Il fait frais, et personne ne descend. »"
+    right:
+      label: "Ici, sous mon lit"
+      effects: {vestiaire: "-", relation: {sacha: 1}}
+      answer: "Trois cartons sous le lit. Tu dors au-dessus de quatre cent soixante et un noms. Tu dors mal, les premiers mois. Puis tu dors."
+
+  - id: sl.h9.apres.four_paye
+    roles: [selectionneur]
