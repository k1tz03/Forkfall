+# Histoire 9 — « Vingt degrés dedans » : le réservoir (postulat `mondial_hiver`,
+# `programme` dans content/postulats.yaml). Quatorze intrigues, trois buckets.
+# Cartes : content/cards/selectionneur/h9_intrigues_*.yaml.
+#
+#   2029 (bucket "0") — Le brassard (signature : Noa, son frère sur le toit du
+#     Dôme, Bréhaut qui soupèse le brassard), Le four (la dette de la
+#     boulangerie, le secret de Marie-Jo, l'intermède du vélo), Le virage de dos
+#     (Gégé, la banderole, l'écran de la place), Le contrat du gaz (Gazéo,
+#     Ilyas, la photo bras nus), Les listes (Sacha, Léa, le local forcé), Un peu
+#     de leur fraîcheur (Gigi Vecchio, les gants jaunes, la bouteille du Dôme).
+#   2030 (bucket "1") — Les deux listes (ouverte par la voiture blanche, B1 :
+#     « Le capitaine est fatigué »), Le Kambara (Mbako au téléphone, Vence en
+#     direct), Les cadeaux (les clés de la terrasse, le coursier, le fisc), La
+#     rue Haute (ouverte par la cave, B2 : Madame Aubert, Léa, Josiane témoin).
+#   2031 (bucket "2+", tardives) — La tente blanche (ouverte par le retour,
+#     C1 : la contre-autopsie, la plaque, la page six), Le palais (la mise en
+#     examen d'Aubert), L'autre boulangerie (le prix du silence).
+#
+# Le Mondial ne se passe pas à Aubérive : du départ (S1, créneau 13) au tunnel
+# (17), la sélection est à Al-Dorado. Une étape qui tombe dans ces créneaux-là
+# a une variante `_loin` (`season == 1 && flag('h9_depart')`), relue à chaque
+# tirage par le metteur en scène : le coup de fil à l'hôtel, la salle de presse
+# du Dôme, l'enveloppe glissée sous la porte.
+#
+# Les sauts d'intrigue (une carte d'étape planifiée par `schedule:`) :
+#   · B1 la voiture blanche → sl.h9.deux_listes.listes ;
+#   · B2 la cave → sl.h9.rue_haute.visite, qui déclenche le soir même le fisc
+#     (la réaction sl.h9.re.fisc : l'État reprend ce que l'émirat a donné) ;
+#   · B3 le départ → sl.h9.brassard.fouille (Noa garde le brassard sur lui) ou
+#     sl.h9.brassard.douane (dans ta valise), chacun tiré par `rand:` ;
+#   · C1 le retour → sl.h9.exhumation.resultat (le cercueil ouvert).
+arcs:
+  # ══════════════════════════════════════════════════════════════ 2029 (S0)
+  - id: sl.h9.brassard
+    title: "Le brassard"
+    kind: serie
+    roles: [selectionneur]
+    postulats: [mondial_hiver]
+    foreground: true
+    weight: 1.2
+    once: true
+    theme: vestiaire
+    carrier: vandel
+    cast: [vandel, mariejo, brehaut, sauvan, vence]
+    when: "flag('histoire_h9') && season <= 1"
+    issues: [porte, cache]
+    traces:
+      h9_brassard_photo: "{annee} : Noa Vandel s'est entraîné brassard noir au bras. Télé-Stade a filmé ; {nom} a laissé faire."
+      h9_brassard_cache: "{annee} : aux photos officielles, le brassard noir dormait sous le protège-tibia de Noa Vandel."
+      h9_frere_appel: "{annee} : le frère de Noa Vandel a appelé du chantier du Dôme. Il travaille encore sur le toit."
+      h9_brassard_promis: "{annee} : devant Bréhaut, {nom} a promis que Noa Vandel porterait le brassard noir."
+    hint: "Un brassard cousu main, un capitaine, et un pays qui préférerait des bras nus."
+    same_club: true
+    fallback: drop
+    steps:
+      - id: entrainement
+        card:
+          - { id: sl.h9.brassard.entrainement_permis, if: "flag('h9_brassard_permis')" }
+          - { id: sl.h9.brassard.entrainement }
+        next: [ { step: frere, in: [2, 3] } ]
+      - id: frere
+        card:
+          - { id: sl.h9.brassard.frere_loin, if: "season == 1 && flag('h9_depart')" }
+          - { id: sl.h9.brassard.frere }
+        next: [ { step: serment, in: [2, 4] } ]
+      - id: serment
+        card:
+          - { id: sl.h9.brassard.serment_loin, if: "season == 1 && flag('h9_depart')" }
+          - { id: sl.h9.brassard.serment }
+        next: []
+      # La fouille du capitaine et la douane de ta valise ne sont plus des
+      # sauts : le départ (B3) les tire par `rand:` (vars.h9_fouille), et
+      # l'aéroport (B35, une ancre du script au créneau 13) les sert.
+
+  - id: sl.h9.four
+    title: "Le four"
+    kind: serie
+    roles: [selectionneur]
+    postulats: [mondial_hiver]
+    foreground: true
+    weight: 1.0
+    once: true
+    theme: famille
+    carrier: mariejo
+    cast: [mariejo]
+    when: "flag('histoire_h9') && season <= 1"
+    issues: [caution, refus]
+    traces:
+      h9_four_secret: "{annee} : Marie-Jo Marçais a dit à {nom} pourquoi Kévin était parti travailler au Dôme."
+      h9_four_caution: "{annee} : {nom} s'est porté{pg, select, f{e} other{}} caution du four neuf de la boulangerie Marçais."
+      h9_four_refus: "{annee} : la boulangerie Marçais doit toujours son four à la banque. {nom} n'a rien signé."
+    hint: "Un four neuf qui n'est pas payé, et une mère qui sait pourquoi son fils est parti."
+    same_club: true
+    fallback: drop
+    steps:
+      - id: lettre
+        card: sl.h9.four.lettre
+        next: [ { step: fournil, in: [2, 4] } ]
+      - id: fournil
+        card: sl.h9.four.fournil
+        next: [ { step: banque, in: [2, 4] } ]
+      - id: banque
+        card: sl.h9.four.banque
+        next: [ { step: velo, in: [2, 5] } ]
+      # L'intermède de 2029 (une nuit qu'on ne se rappelle pas) ; plus tard,
+      # le vélo remonte de la cave pour de vrai.
+      - id: velo
+        card:
+          - { id: sl.h9.four.velo, if: "season == 0" }
+          - { id: sl.h9.four.velo_cave }
+        next: []
+
+  - id: sl.h9.virage
+    title: "Le virage de dos"
+    kind: serie
+    roles: [selectionneur]
+    postulats: [mondial_hiver]
+    foreground: true
+    weight: 1.0
+    once: true
+    theme: tribune
+    carrier: gege
+    cast: [gege, mariejo, vecchio]
+    when: "flag('histoire_h9') && season <= 1"
+    issues: [dos, face]
+    traces:
+      h9_banderole: "{annee} : le virage Nord a déroulé KÉVIN MARÇAIS 2004-2028 avant le coup d'envoi. Personne n'y a touché."
+      h9_banderole_decrochee: "{annee} : {nom} a fait décrocher la banderole pour Kévin Marçais. Gégé l'a roulée lui-même."
+      h9_virage_dos: "{annee} : le virage d'Aubérive regardera le Mondial de dos, devant l'écran de la place du marché."
+      h9_virage_face: "{annee} : Gégé a promis que le virage regarderait le Mondial de face. À une condition."
+    hint: "Soixante ans de virage, et un Mondial qu'on regardera de dos."
+    same_club: true
+    fallback: drop
+    steps:
+      - id: buvette
+        card: sl.h9.virage.buvette
+        next: [ { step: banderole, in: [2, 4] } ]
+      - id: banderole
+        card: sl.h9.virage.banderole
+        next: [ { step: ecran, in: [2, 4] } ]
+      - id: ecran
+        card:
+          - { id: sl.h9.virage.ecran_loin, if: "season == 1 && flag('h9_depart')" }
+          - { id: sl.h9.virage.ecran }
+        next: []
+
+  - id: sl.h9.gazeo
+    title: "Le contrat du gaz"
+    kind: serie
+    roles: [selectionneur]
+    postulats: [mondial_hiver]
+    foreground: true
+    weight: 0.9
+    once: true
+    theme: contrat
+    carrier: brehaut
+    cast: [brehaut, nassir, vandel]
+    when: "flag('histoire_h9') && season <= 1"
+    issues: [pose, refuse]
+    traces:
+      h9_prime_gazeo: "{annee} : la prime de Gazéo est tombée la veille d'un grand match. Elle tombe toujours la veille."
+      h9_prime_bloquee: "{annee} : {nom} a bloqué la prime de Gazéo jusqu'après le Mondial. Le vestiaire l'a su le soir même."
+      h9_photo_gazeo: "{annee} : les Cobalts ont posé devant la flamme bleue de Gazéo, souriants, les bras nus."
+      h9_photo_refusee: "{annee} : pas de photo devant la flamme bleue. Gazéo s'est dite « déçue », par communiqué."
+    hint: "Le gaz paie les primes depuis 2010. Il paie aussi pour le sourire."
+    same_club: true
+    fallback: drop
+    steps:
+      - id: prime
+        card: sl.h9.gazeo.prime
+        next: [ { step: ligne, in: [2, 4] } ]
+      - id: ligne
+        card: sl.h9.gazeo.ligne
+        next: [ { step: photo, in: [2, 4] } ]
+      - id: photo
+        card:
+          - { id: sl.h9.gazeo.photo_loin, if: "season == 1 && flag('h9_depart')" }
+          - { id: sl.h9.gazeo.photo_brassard, if: "flag('h9_brassard_photo') || flag('h9_brassard_promis')" }
+          - { id: sl.h9.gazeo.photo }
+        next: []
+
+  - id: sl.h9.listes
+    title: "Les listes"
+    kind: serie
+    roles: [selectionneur]
+    postulats: [mondial_hiver]
+    foreground: true
+    weight: 1.0
+    once: true
