+    lieu: stade
+    tone: leger
+    once: true
+    when: "flag('histoire_h9') && season == 0 && chars.vecchio.statut != 'mort'"
+    text: "Gigi Vecchio, à la main courante, regarde tes gardiens plonger sous la pluie : « Le grand plonge trop tôt. Le petit, trop beau. Moi, je plongeais quand le ballon était parti. »"
+    left:
+      label: "Montrez-leur"
+      effects: {vestiaire: "+", relation: {vecchio: 1}}
