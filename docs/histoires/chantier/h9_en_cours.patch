+# Histoire 9 — « Vingt degrés dedans » : les cartes des intrigues de 2029
+# (content/arcs/selectionneur/h9_intrigues.yaml) — Le brassard, Le four, Le
+# virage de dos, Le contrat du gaz, Les listes, Un peu de leur fraîcheur.
+# Une variante `_loin` est la même scène vue d'Al-Dorado (créneaux 13-17 de
+# 2030) : le coup de fil à l'hôtel, la vitre, la climatisation.
+cards:
+  # ═══════════════════════════════════════════════════════ LE BRASSARD
+  - id: sl.h9.brassard.entrainement
+    roles: [selectionneur]
+    arc: vestiaire
+    tags: [vestiaire, presse]
+    speaker: vandel
+    lieu: terrain
+    tone: strategique
+    once: true
+    when: "flag('histoire_h9') && season <= 1"
+    text: "Terrain annexe, entraînement ouvert à la presse. Noa s'échauffe brassard noir au bras, sans te l'avoir redemandé. La caméra de Télé-Stade a cessé de filmer les autres."
+    left:
+      label: "Laisse-les filmer"
+      effects: {tribunes: "+", direction: "-", set: [h9_brassard_photo], outcome: porte}
+      answer: "Le soir, Télé-Stade passe dix secondes de bras noir au journal. À vingt heures et une, le ministère appelle la Fédération."
+    right:
+      label: "Range-le, Noa"
+      effects: {tribunes: "-", direction: "+", vestiaire: "-", relation: {vandel: -1}, set: [h9_brassard_cache], outcome: cache}
+      answer: "Il le défait sans te regarder et le glisse sous son protège-tibia. Pendant la séance, il touche sa jambe à chaque arrêt de jeu."
+
+  - id: sl.h9.brassard.entrainement_permis
+    roles: [selectionneur]
+    arc: vestiaire
+    tags: [vestiaire, presse]
+    speaker: vandel
+    lieu: terrain
+    tone: strategique
+    once: true
+    when: "flag('histoire_h9') && season <= 1"
+    text: "Terrain annexe, entraînement ouvert. Noa porte le brassard noir, comme tu l'as permis. Il s'arrête devant toi : « La télé est là, le ministère aussi. Je l'enlève pour les photos, {toi} ? »"
+    left:
+      label: "Garde-le"
+      effects: {tribunes: "+", direction: "-", set: [h9_brassard_photo], outcome: porte}
+      answer: "Il serre le nœud d'un cran. Au bord du terrain, un homme en manteau gris photographie le brassard, pas le joueur."
+    right:
+      label: "Enlève-le, pour l'instant"
+      effects: {tribunes: "-", direction: "+", vestiaire: "-", set: [h9_brassard_cache], outcome: cache}
+      answer: "Il le range sous son protège-tibia gauche. « Pour l'instant », répète-t-il, comme on note une date dans un agenda."
+
+  - id: sl.h9.brassard.frere
+    roles: [selectionneur]
+    arc: vestiaire
+    tags: [vestiaire, famille]
+    speaker: vandel
+    lieu: vestiaire
+    tone: strategique
+    once: true
+    when: "flag('histoire_h9') && season <= 1"
+    text: "Vestiaire vide. Noa te montre une photo envoyée du Dôme : un dortoir de douze lits, un thermomètre à cinquante et un. « Mon frère. Il dit : si je le porte, c'est eux qui rentrent plus tôt. »"
+    left:
+      label: "Rappelle-le avec moi"
+      effects: {vestiaire: "+", relation: {vandel: 1}, set: [h9_frere_appel]}
+      answer: "Le frère décroche sur le toit ; on entend le vent et une radio. Il te parle poliment, comme à la télévision, puis demande le score."
+    right:
+      label: "C'est à toi de voir"
+      effects: {direction: "+", set: [h9_frere_appel, h9_frere_seul]}
+      answer: "Il range le téléphone. À la séance, il tire trois fois au-dessus, et ne va pas chercher les ballons."
+
+  - id: sl.h9.brassard.frere_loin
+    roles: [selectionneur]
+    arc: vestiaire
+    tags: [vestiaire, al_dorado]
+    speaker: vandel
+    lieu: ailleurs
+    tone: leger
+    once: true
+    when: "flag('histoire_h9') && season <= 1"
+    text: "Al-Dorado, l'hôtel des délégations. Noa colle son front à la vitre : au loin, les grues du Dôme. « Mon frère est là-dessus. Il dit : si je le porte, c'est eux qui rentrent plus tôt. »"
+    left:
