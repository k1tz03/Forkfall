+    tone: leger
+    once: true
+    when: "flag('histoire_h9') && !(season == 1 && flag('h9_depart'))"
+    text: "Gégé compte les marches de la tribune Nord en les montant, une main sur la rampe : « Cinquante-deux. En 1990, j'en comptais cinquante. Ils en ont ajouté, {toi}, ou c'est moi ? »"
+    left:
+      label: "Ils en ont ajouté"
+      effects: {tribunes: "+", relation: {gege: 1}}
