+# Histoire 9 — « Vingt degrés dedans » : les trois missions du livre (format :
+# en-tête de content/ville/missions.yaml). Elles laissent des drapeaux `vl_h9_*`
+# que le script lit :
+#   · h9_four — l'échéance du four de la boulangerie (le pendant, en francs,
+#     de la caution de l'intrigue *Le four*) : vl_h9_four, lu en décembre 2031
+#     (le four qui chauffe, la date gravée dans la porte).
+#   · h9_cave — les cartons de Madame Josiane, si les listes de Sacha ont été
+#     lues : vl_h9_cave, lu par la cave de 2030 (le carton déjà remonté).
+#   · h9_valise — le brassard cousu dans la doublure de ta valise : vl_h9_valise,
+#     lu par le départ (la valise qu'on fouille moins) et par la douane d'Al-Dorado
+#     (le douanier qui trouve la doublure). Le risque n'est pas ici : il est tiré
+#     au départ, dans le moteur.
+missions:
+  - id: h9_four
+    titre: "L'échéance du four"
+    roles: [selectionneur]
+    donneur: {sprite: passante, nom: "Marie-Jo Marçais", lieu: boulangerie_residentiel, tranches: [matin]}
+    si: "flag(histoire_h9) && !flag(h9_four_caution) && annee <= 2030"
+    chance: 0.35
+    etapes:
+      - id: offre
+        texte: "Marie-Jo compte ta monnaie deux fois, et se trompe deux fois. Sous la caisse, la lettre de la banque, du rouge partout. « L'échéance du four. {montant}, avant la fin du mois. »"
+        choix:
+          - id: payer
+            label: "Je paie l'échéance"
+            francs: -12000
+            effets: {jauges: {tribunes: 2}, set: [vl_h9_four]}
+            reponse: "Elle refuse trois fois, puis prend l'enveloppe. Ce jour-là, ta baguette est gratuite. Le lendemain, elle te la fait payer, au centime."
+            suite: fin
+          - id: rien
+            label: "Je n'ai pas de quoi"
+            reponse: "Elle range la lettre sous la caisse, à sa place. « Je disais ça comme ça. » Puis elle te demande le score, pour la première fois."
+            suite: fin
+
+  - id: h9_cave
+    titre: "Les cartons de la cave"
+    roles: [selectionneur]
+    donneur: {sprite: passante, nom: "Madame Josiane", lieu: clubhouse, tranches: [matin, aprem]}
+    si: "flag(histoire_h9) && flag(h9_listes_lues) && !flag(h9_cave_vue)"
+    chance: 0.4
+    etapes:
+      - id: offre
+        texte: "Madame Josiane, sans lever les yeux de sa machine : « Les archives de la Fédération dorment dans la cave du club-house. Trente ans de cartons. Mes genoux n'y descendent plus. »"
+        choix:
+          - id: porter
+            label: "Je descends avec vous"
+            reponse: "« Ce soir, alors. Prenez une lampe : l'ampoule de l'escalier n'a pas été changée depuis 1998. Moi non plus. »"
+            suite: cave
+          - id: non
+            label: "Pas cette semaine"
+            reponse: "Elle hoche la tête et reprend sa frappe, deux doigts, régulière. « Les cartons ne bougeront pas. C'est leur qualité. »"
+            suite: fin
+      - id: cave
+        objectif: {lieu: clubhouse, tranches: [soir], delai: 4}
+        texte: "La cave du club-house, une ampoule nue. Une année par carton, jusqu'au plafond. Josiane, assise sur la dernière marche, montre celui de 2010, tout en bas : « Celui-là, on le remonte. »"
+        choix:
+          - id: remonter
+            label: "Je le remonte"
+            effets: {set: [vl_h9_cave]}
+            reponse: "Il pèse plus lourd que les autres, parce qu'il est en bas. Josiane le fait poser sur sa table, sans l'ouvrir. « Pas ce soir. Bientôt. »"
+            suite: fin
+          - id: laisser
+            label: "On le laisse en bas"
+            reponse: "Elle n'insiste pas. En remontant, elle compte les marches à voix haute, et s'arrête à la vingt-troisième, pour souffler."
+            suite: fin
+        echec:
+          texte: "La semaine est passée. Josiane a descendu les cartons seule, un par un, sur trois soirs. Celui de 2010 est resté où il était, tout en bas de la pile."
+
+  - id: h9_valise
+    titre: "La valise"
+    roles: [selectionneur]
+    donneur: {sprite: passante, nom: "Marie-Jo Marçais", lieu: boulangerie_residentiel, tranches: [matin]}
+    si: "flag(histoire_h9) && annee == 2030 && !flag(h9_depart) && !flag(h9_liste_ministere)"
+    chance: 0.4
+    etapes:
+      - id: offre
+        texte: "Marie-Jo, à l'heure où la boutique est vide : « Ils fouilleront la valise du capitaine, c'est sûr. La vôtre, peut-être pas. Apportez-la-moi. Je sais coudre. »"
+        choix:
+          - id: oui
+            label: "Je vous l'apporte"
+            reponse: "« À midi, quand j'ai fermé. » Elle te sert ta baguette, puis une deuxième, sans raison. « Pour le voyage. »"
+            suite: couture
+          - id: non
+            label: "C'est trop risqué"
+            reponse: "« Pour qui ? » Elle ne dit rien d'autre. Elle rend la monnaie comme on rend un objet emprunté."
+            suite: fin
+      - id: couture
+        objectif: {lieu: boulangerie_residentiel, tranches: [midi], delai: 4}
+        texte: "L'arrière-boutique, sur la table à pâtisserie. Marie-Jo découd la doublure de ta valise, glisse le brassard noir à plat, et recoud à petits points, sans lever les yeux."
+        choix:
+          - id: regarder
+            label: "Je la regarde coudre"
+            effets: {set: [vl_h9_valise]}
+            reponse: "Elle coupe le fil avec les dents. « Personne ne fouille une doublure de boulangère. » Elle n'en sait rien. Toi non plus."
+            suite: fin
+          - id: detourner
+            label: "Je regarde la rue"
+            effets: {set: [vl_h9_valise]}
+            reponse: "Quand tu te retournes, la valise est fermée, et rien ne se voit. Marie-Jo se lave les mains longtemps, comme après une fournée."
+            suite: fin
+        echec:
+          texte: "Midi est passé deux fois sans toi. Le brassard reste chez Noa, sous son protège-tibia. Marie-Jo a gardé la table à pâtisserie libre, pour rien."
