+    roles: [selectionneur]
+    arc: vestiaire
+    tags: [vestiaire, decor]
+    tone: leger
+    once: true
+    when: "flag('histoire_h9') && season >= 3 && seen('sl.h9.apres.raccroche')"
+    text: "La liste de mars, la première sans Noa Vandel. Vingt-six noms tapés à la machine. Au vingt-septième rang, au crayon, quelqu'un a dessiné un petit brassard."
+    left:
+      label: "Je l'efface"
+      effects: {direction: "+"}
+      answer: "La gomme laisse une trace grise, en forme de brassard. Tu envoies la liste comme ça. Personne ne pose de question."
