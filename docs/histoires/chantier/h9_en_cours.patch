+    tone: leger
+    once: true
+    when: "flag('histoire_h9') && flag('h9_prime_bloquee') && !(season == 1 && flag('h9_depart'))"
+    text: "Noa, au vestiaire, à voix basse : « Les gars demandent pour la prime de Gazéo. Je leur ai dit que vous aviez vos raisons. Vous les avez, {toi} ? »"
+    left:
+      label: "Je les ai"
+      effects: {vestiaire: "-", relation: {vandel: 1}}
