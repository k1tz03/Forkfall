+    tags: [vestiaire, decor]
+    speaker: vandel
+    lieu: rue
+    tone: leger
+    once: true
+    when: "flag('histoire_h9') && season <= 1 && !(season == 1 && flag('h9_depart'))"
+    text: "Six heures, les quais de la Rive. Noa court à côté de toi sans rien dire, puis s'arrête net devant la boulangerie éclairée : « Elle est déjà levée. Elle ne dort plus, je crois. »"
+    left:
