+    right:
+      label: "Ils apprendront"
+      effects: {direction: "+"}
+      answer: "« Ils apprendront, oui. Sous un toit, on n'apprend rien. » Il remonte son col et rentre à la buvette, sans se presser."
+
+  # ═══════════════════════════════════════════════ LA VILLE, LE VIRAGE
+  - id: sl.h9.rt.gege_marches
